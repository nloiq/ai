@model NLOIQ.Application.Content.NavigationEdit
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
<article data-row class="cms-row"><div class="grid gap-4 md:grid-cols-2"><label class="cms-field">@L["CmsLabelEn"]<input asp-for="LabelEn" type="text" maxlength="120" dir="ltr" class="cms-input"></label><label class="cms-field">@L["CmsLabelAr"]<input asp-for="LabelAr" type="text" maxlength="120" dir="rtl" class="cms-input"></label><label class="cms-field">@L["CmsTarget"]<input asp-for="Href" type="text" maxlength="500" dir="ltr" class="cms-input"></label><label class="cms-field">@L["CmsParent"]<input asp-for="ParentIndex" type="number" min="0" data-parent class="cms-input"></label><label class="cms-field">@L["CmsVisible"]<select asp-for="IsVisible" class="cms-input"><option value="true">✓</option><option value="false">—</option></select></label></div><div class="mt-4 flex flex-wrap gap-2 border-t border-line pt-3"><button type="button" data-row-up class="cms-small">@L["CmsUp"]</button><button type="button" data-row-down class="cms-small">@L["CmsDown"]</button><button type="button" data-row-remove class="cms-small">@L["CmsRemove"]</button><button type="button" draggable="true" data-row-drag class="cms-small" aria-label="@L["CmsOrder"]">↕</button></div></article>