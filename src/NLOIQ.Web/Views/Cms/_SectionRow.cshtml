@model NLOIQ.Application.Content.SectionEdit
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
<article data-row class="cms-row">@{ var choices=(NLOIQ.Application.Content.EditorChoices)ViewData["Choices"]!; }<div class="grid gap-4 md:grid-cols-2"><label class="cms-field">@L["CmsSections"]<select asp-for="ContentItemId" class="cms-input">@foreach(var choice in choices.Sections){<option value="@choice.Id">@choice.Label</option>}</select></label><label class="cms-field">@L["CmsOrder"]<input asp-for="DisplayOrder" type="number" min="0" data-order class="cms-input"></label></div><div class="mt-4 flex flex-wrap gap-2 border-t border-line pt-3"><button type="button" data-row-up class="cms-small">@L["CmsUp"]</button><button type="button" data-row-down class="cms-small">@L["CmsDown"]</button><button type="button" data-row-remove class="cms-small">@L["CmsRemove"]</button><button type="button" draggable="true" data-row-drag class="cms-small" aria-label="@L["CmsOrder"]">↕</button></div></article>