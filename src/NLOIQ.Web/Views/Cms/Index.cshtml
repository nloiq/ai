@model IReadOnlyList<NLOIQ.Application.Content.ContentListRow>
@using NLOIQ.Domain.Content
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{ Layout="_AdminLayout"; ViewData["Title"]=L["CmsTitle"]; var culture=Context.Request.RouteValues["culture"]?.ToString(); var kinds=new[]{ContentKind.Page,ContentKind.Section,ContentKind.Project,ContentKind.ProjectCategory,ContentKind.Service,ContentKind.Navigation,ContentKind.Contact,ContentKind.Footer}; }
<h1 class="text-3xl font-semibold">@L["CmsTitle"]</h1><p class="mt-4 max-w-3xl leading-7 text-muted">@L["CmsIntro"]</p>
<nav class="mt-6 flex flex-wrap gap-2" aria-label="@L["CmsNew"]">@foreach(var kind in kinds){<a class="inline-flex min-h-11 items-center border border-line bg-panel px-3 text-sm" href="/@culture/admin/content/new?kind=@kind">+ @L["CmsKind"+kind]</a>}</nav>
<div class="mt-4 flex flex-wrap gap-4 text-sm"><a href="/@culture/admin/content?kind=Section&sectionKind=Hero" class="inline-flex min-h-11 items-center underline">@L["CmsSectionHero"]</a><a href="/@culture/admin/content?kind=Section&sectionKind=About" class="inline-flex min-h-11 items-center underline">@L["CmsSectionAbout"]</a></div>
<form method="get" class="my-6 flex flex-wrap items-end gap-3"><label class="text-sm">@L["CmsSearch"]<input name="search" value="@Context.Request.Query["search"]" maxlength="80" class="mt-2 block min-h-11 w-52 border border-line bg-paper px-3"></label><label class="text-sm">@L["CmsFilter"]<select name="kind" class="mt-2 block min-h-11 border border-line bg-paper px-3"><option value="">@L["CmsAll"]</option>@foreach(var kind in kinds){<option value="@kind" selected="@(Context.Request.Query["kind"]==kind.ToString())">@L["CmsKind"+kind]</option>}</select></label><button class="min-h-11 bg-accent px-4 text-on-accent">@L["CmsFilter"]</button></form>
<div class="grid gap-4 xl:grid-cols-2">@foreach(var item in Model){<article class="min-w-0 border border-line bg-panel p-5"><div class="flex flex-wrap justify-between gap-2 text-xs text-signal"><span>@L["CmsKind"+item.Kind] / @item.Key</span><span>@L["Cms"+item.State]</span></div><h2 class="mt-3 break-words text-xl">@item.Title</h2><p class="mt-3 text-xs text-muted">@L["CmsRevision"] @item.Revision @if(item.IsDemo){<span> · @L["CmsDemo"]</span>}</p><a class="mt-3 inline-flex min-h-11 items-center text-sm underline underline-offset-4" href="/@culture/admin/content/@item.Id">@L["CmsEdit"]</a></article>}</div>
@if(Model.Count==0){<p>@L["CmsEmpty"]</p>}
