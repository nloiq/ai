@model IReadOnlyList<NLOIQ.Application.Content.ContentListRow>
@using NLOIQ.Domain.Content
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{ Layout="_AdminLayout"; ViewData["Title"]=L["CmsTitle"]; var culture=Context.Request.RouteValues["culture"]?.ToString(); var kinds=new[]{ContentKind.Page,ContentKind.Section,ContentKind.Project,ContentKind.ProjectCategory,ContentKind.Service,ContentKind.Navigation,ContentKind.Contact,ContentKind.Footer}; }
<h1 class="text-3xl font-semibold">@L["CmsTitle"]</h1><p class="mt-4 max-w-3xl leading-7 text-muted">@L["CmsIntro"]</p>
<nav class="mt-6 flex flex-wrap gap-2" aria-label="@L["CmsNew"]">@foreach(var kind in kinds){<a class="inline-flex min-h-11 items-center border border-line bg-panel px-3 text-sm" href="/@culture/admin/content/new?kind=@kind">+ @L["CmsKind"+kind]</a>}</nav>
<div class="mt-4 flex flex-wrap gap-4 text-sm"><a href="/@culture/admin/content?kind=Section&sectionKind=Hero" class="inline-flex min-h-11 items-center underline">@L["CmsSectionHero"]</a><a href="/@culture/admin/content?kind=Section&sectionKind=About" class="inline-flex min-h-11 items-center underline">@L["CmsSectionAbout"]</a></div>
<form method="get" class="my-6 flex flex-wrap items-end gap-3"><label class="text-sm">@L["CmsSearch"]<input name="search" value="@Context.Request.Query["search"]" maxlength="80" class="mt-2 block min-h-11 w-52 border border-line bg-paper px-3"></label><label class="text-sm">@L["CmsFilter"]<select name="kind" class="mt-2 block min-h-11 border border-line bg-paper px-3"><option value="">@L["CmsAll"]</option>@foreach(var kind in kinds){<option value="@kind" selected="@(Context.Request.Query["kind"]==kind.ToString())">@L["CmsKind"+kind]</option>}</select></label><label class="text-sm">@L["WorkflowState"]<select name="state" class="mt-2 block min-h-11 border border-line bg-paper px-3"><option value="">@L["CmsAll"]</option>@foreach(var state in Enum.GetValues<PublicationState>()){<option value="@state" selected="@(Context.Request.Query["state"]==state.ToString())">@L["Cms"+state]</option>}</select></label><label class="flex min-h-11 items-center gap-2 text-sm"><input type="checkbox" name="changes" value="true" checked="@(Context.Request.Query["changes"]=="true")">@L["WorkflowChanges"]</label><button class="min-h-11 bg-accent px-4 text-on-accent">@L["CmsFilter"]</button></form>
<p class="mb-3 text-sm text-muted">@L["CmsItemCount",Model.Count]</p>
<div class="cms-table-scroll" role="region" aria-label="@L["CmsContentTable"]" tabindex="0">
<table class="cms-content-table"><caption class="sr-only">@L["CmsContentTable"]</caption><thead><tr>
<th scope="col">ID</th><th scope="col">@L["CmsTitleField"]</th><th scope="col">@L["CmsKey"]</th><th scope="col">@L["CmsKind"]</th><th scope="col">@L["WorkflowState"]</th><th scope="col">@L["CmsRevision"]</th><th scope="col">@L["WorkflowChanges"]</th><th scope="col">@L["CmsContentType"]</th><th scope="col">@L["CmsActions"]</th>
</tr></thead><tbody>@foreach(var item in Model){var displayTitle=string.IsNullOrWhiteSpace(item.Title)?item.Key:item.Title;<tr data-content-key="@item.Key">
<td class="whitespace-nowrap text-muted"><bdi dir="ltr">#@item.Id</bdi></td>
<th scope="row" class="cms-table-title"><a href="/@culture/admin/content/@item.Id" class="font-semibold underline underline-offset-4">@displayTitle</a></th>
<td class="cms-table-key"><bdi dir="ltr">@item.Key</bdi></td>
<td>@L["CmsKind"+item.Kind]@if(item.SectionKind is not null){<span class="mt-1 block text-xs text-muted">@L["CmsSection"+item.SectionKind]</span>}</td>
<td><span class="inline-block whitespace-nowrap rounded border border-line bg-panel px-2 py-1 text-xs">@L["Cms"+item.State]</span></td>
<td>@item.Revision</td>
<td class="text-xs @(item.HasUnpublishedChanges?"text-accent":"text-muted")">@L[item.HasUnpublishedChanges?"CmsPendingChanges":"CmsUpToDate"]</td>
<td class="text-xs @(item.IsDemo?"text-accent":"text-muted")">@L[item.IsDemo?"CmsDemo":"CmsStandard"]</td>
<td><div class="flex items-center gap-4 whitespace-nowrap"><a class="inline-flex min-h-11 items-center underline underline-offset-4" href="/@culture/admin/content/@item.Id" aria-label="@L["CmsEdit"]: @displayTitle">@L["CmsEdit"]</a>@if(item.Revision>0){<a class="inline-flex min-h-11 items-center underline underline-offset-4" href="/@culture/admin/content/@item.Id/preview" aria-label="@L["WorkflowPreview"]: @displayTitle">@L["CmsTablePreview"]</a><a class="inline-flex min-h-11 items-center underline underline-offset-4" href="/@culture/admin/content/@item.Id/history" aria-label="@L["WorkflowHistory"]: @displayTitle">@L["CmsTableHistory"]</a>}</div></td>
</tr>}
@if(Model.Count==0){<tr><td colspan="9" class="py-8 text-muted">@L["CmsEmpty"]</td></tr>}
</tbody></table></div>
