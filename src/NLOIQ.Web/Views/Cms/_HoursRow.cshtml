@model NLOIQ.Application.Content.HoursEdit
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
<article data-row class="cms-row"><div class="grid gap-4 md:grid-cols-2"><label class="cms-field">@L["CmsDay"]<select asp-for="DayOfWeek" class="cms-input">@for(var day=0;day<7;day++){<option value="@day">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName((DayOfWeek)day)</option>}</select></label><label class="cms-field">@L["CmsClosed"]<select asp-for="IsClosed" class="cms-input"><option value="true">@L["HoursClosed"]</option><option value="false">@L["HoursOpen"]</option></select></label><label class="cms-field">@L["CmsOpenTime"]<input asp-for="OpensAt" type="time"  class="cms-input"></label><label class="cms-field">@L["CmsCloseTime"]<input asp-for="ClosesAt" type="time"  class="cms-input"></label></div><div class="mt-4 flex flex-wrap gap-2 border-t border-line pt-3"><button type="button" data-row-up class="cms-small">@L["CmsUp"]</button><button type="button" data-row-down class="cms-small">@L["CmsDown"]</button><button type="button" data-row-remove class="cms-small">@L["CmsRemove"]</button><button type="button" draggable="true" data-row-drag class="cms-small" aria-label="@L["CmsOrder"]">↕</button></div></article>