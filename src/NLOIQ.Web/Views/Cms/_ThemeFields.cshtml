@model NLOIQ.Application.Content.ThemeEdit
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
<section class="cms-panel"><h2 class="text-xl">@L["ThemeTitle"]</h2><p class="my-4 text-sm leading-7 text-muted">@L["ThemeHelp"]</p><div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3"><label class="cms-field">@L["ThemeEvergreen"]<input asp-for="Evergreen" type="color" required class="cms-input min-h-14" data-brand-token="Evergreen"></label><label class="cms-field">@L["ThemeForest"]<input asp-for="Forest" type="color" required class="cms-input min-h-14" data-brand-token="Forest"></label><label class="cms-field">@L["ThemeMoss"]<input asp-for="Moss" type="color" required class="cms-input min-h-14" data-brand-token="Moss"></label><label class="cms-field">@L["ThemeBurntOrange"]<input asp-for="BurntOrange" type="color" required class="cms-input min-h-14" data-brand-token="BurntOrange"></label><label class="cms-field">@L["ThemeCopper"]<input asp-for="Copper" type="color" required class="cms-input min-h-14" data-brand-token="Copper"></label><label class="cms-field">@L["ThemeGold"]<input asp-for="Gold" type="color" required class="cms-input min-h-14" data-brand-token="Gold"></label><label class="cms-field">@L["ThemeIvory"]<input asp-for="Ivory" type="color" required class="cms-input min-h-14" data-brand-token="Ivory"></label><label class="cms-field">@L["ThemeCharcoal"]<input asp-for="Charcoal" type="color" required class="cms-input min-h-14" data-brand-token="Charcoal"></label><label class="cms-field">@L["ThemeLightAction"]<input asp-for="LightAction" type="color" required class="cms-input min-h-14" data-brand-token="LightAction"></label><label class="cms-field">@L["ThemeSignalLight"]<input asp-for="SignalLight" type="color" required class="cms-input min-h-14" data-brand-token="SignalLight"></label><label class="cms-field">@L["ThemeSignalDark"]<input asp-for="SignalDark" type="color" required class="cms-input min-h-14" data-brand-token="SignalDark"></label></div><div class="mt-8 grid gap-4 md:grid-cols-2">@foreach(var mode in new[]{"light","dark"}){<div data-theme-preview="@mode" class="border border-line bg-paper p-5 text-ink"><p class="text-xs text-signal">@(mode=="light"?L["ThemeLightPreview"]:L["ThemeDarkPreview"])</p><h3 class="my-5 font-editorial text-3xl">@L["ThemePreviewText"]</h3><button type="button" class="min-h-11 bg-accent px-4 text-on-accent">@L["ThemePreviewAction"]</button></div>}</div></section>