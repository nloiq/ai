@model NLOIQ.Application.Content.ThemeEdit
@inject NLOIQ.Application.Content.IBrandReader PreviewBrandReader
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{var previewBrand=await PreviewBrandReader.ReadAsync(Context.Request.RouteValues["culture"]?.ToString()??"en");}
<section class="cms-panel"><h2 class="text-xl">@L["ThemeTitle"]</h2><p class="my-4 text-sm leading-7 text-muted">@L["ThemeHelp"]</p><div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3"><label class="cms-field">@L["ThemeEvergreen"]<input asp-for="Evergreen" type="color" required class="cms-input min-h-14" data-brand-token="Evergreen"></label><label class="cms-field">@L["ThemeForest"]<input asp-for="Forest" type="color" required class="cms-input min-h-14" data-brand-token="Forest"></label><label class="cms-field">@L["ThemeMoss"]<input asp-for="Moss" type="color" required class="cms-input min-h-14" data-brand-token="Moss"></label><label class="cms-field">@L["ThemeBurntOrange"]<input asp-for="BurntOrange" type="color" required class="cms-input min-h-14" data-brand-token="BurntOrange"></label><label class="cms-field">@L["ThemeCopper"]<input asp-for="Copper" type="color" required class="cms-input min-h-14" data-brand-token="Copper"></label><label class="cms-field">@L["ThemeGold"]<input asp-for="Gold" type="color" required class="cms-input min-h-14" data-brand-token="Gold"></label><label class="cms-field">@L["ThemeIvory"]<input asp-for="Ivory" type="color" required class="cms-input min-h-14" data-brand-token="Ivory"></label><label class="cms-field">@L["ThemeCharcoal"]<input asp-for="Charcoal" type="color" required class="cms-input min-h-14" data-brand-token="Charcoal"></label><label class="cms-field">@L["ThemeLightAction"]<input asp-for="LightAction" type="color" required class="cms-input min-h-14" data-brand-token="LightAction"></label><label class="cms-field">@L["ThemeSignalLight"]<input asp-for="SignalLight" type="color" required class="cms-input min-h-14" data-brand-token="SignalLight"></label><label class="cms-field">@L["ThemeSignalDark"]<input asp-for="SignalDark" type="color" required class="cms-input min-h-14" data-brand-token="SignalDark"></label></div><div class="mt-8 grid gap-4 md:grid-cols-2">@foreach(var mode in new[]{"light","dark"}){<div data-theme-preview="@mode" class="border border-line bg-paper p-5 text-ink"><div data-header-preview class="mb-5 flex flex-wrap items-center justify-between gap-4"><partial name="_LogoMark" model="previewBrand" /><select data-preview-dropdown aria-label="@L["Theme"]" class="theme-select min-h-11"><option>@L["System"]</option><option>@L["Light"]</option><option>@L["Dark"]</option></select><div data-preview-toggle class="theme-choices" hidden><button type="button" class="min-h-11 px-3" aria-pressed="true">@L["Light"]</button><button type="button" class="min-h-11 px-3" aria-pressed="false">@L["Dark"]</button></div></div><p class="text-xs text-signal">@(mode=="light"?L["ThemeLightPreview"]:L["ThemeDarkPreview"])</p><h3 class="my-5 font-editorial text-3xl">@L["ThemePreviewText"]</h3><button type="button" class="min-h-11 bg-accent px-4 text-on-accent">@L["ThemePreviewAction"]</button></div>}</div></section>
<section class="cms-panel"><h2 class="text-xl">@L["HeaderAppearance"]</h2><p class="my-4 text-sm text-muted">@L["HeaderHelp"]</p><div class="grid gap-5 md:grid-cols-2">
<label class="cms-field flex items-center gap-3"><input asp-for="LogoBorderEnabled" data-header-setting type="checkbox">@L["LogoBorderEnabled"]</label>
<label class="cms-field">@L["LogoBorderColor"]<input asp-for="LogoBorderColor" data-header-setting type="color" class="cms-input"></label>
<label class="cms-field">@L["LogoRadius"]<input asp-for="LogoRadius" data-header-setting type="number" min="0" max="32" class="cms-input"></label>
<label class="cms-field">@L["LogoHeight"]<input asp-for="LogoHeight" data-header-setting type="number" min="24" max="96" class="cms-input"></label>
<label class="cms-field">@L["ThemeSelectorStyle"]<select asp-for="ThemeSelectorStyle" data-header-setting class="cms-input"><option value="0">@L["ThemeDropdown"]</option><option value="1">@L["ThemeToggle"]</option></select></label>
<label class="cms-field">@L["ThemeSelectorRadius"]<input asp-for="ThemeSelectorRadius" data-header-setting type="number" min="0" max="28" class="cms-input"></label>
</div></section>
