@model NLOIQ.Application.Content.SocialEdit
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
<article data-row class="cms-row"><div class="grid gap-4 md:grid-cols-2"><label class="cms-field">@L["CmsSocial"]<select asp-for="Platform" class="cms-input">@foreach(var platform in new[]{"linkedin","facebook","instagram","youtube","x"}){<option value="@platform">@platform</option>}</select></label><label class="cms-field">@L["CmsTarget"]<input asp-for="Url" type="url" maxlength="1000" dir="ltr" class="cms-input"></label></div><div class="mt-4 flex flex-wrap gap-2 border-t border-line pt-3"><button type="button" data-row-up class="cms-small">@L["CmsUp"]</button><button type="button" data-row-down class="cms-small">@L["CmsDown"]</button><button type="button" data-row-remove class="cms-small">@L["CmsRemove"]</button><button type="button" draggable="true" data-row-drag class="cms-small" aria-label="@L["CmsOrder"]">↕</button></div></article>