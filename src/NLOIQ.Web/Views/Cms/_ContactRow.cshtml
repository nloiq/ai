@model NLOIQ.Application.Content.ContactEdit
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
<article data-row class="cms-row"><div class="grid gap-4 md:grid-cols-2"><label class="cms-field">@L["CmsKindContact"]<select asp-for="Kind" asp-items="Html.GetEnumSelectList<NLOIQ.Domain.Content.ContactKind>()" class="cms-input"></select></label><label class="cms-field">@L["CmsValue"]<input asp-for="Value" type="text" maxlength="1000" class="cms-input"></label><label class="cms-field">@L["CmsLabelEn"]<input asp-for="LabelEn" type="text" maxlength="120" dir="ltr" class="cms-input"></label><label class="cms-field">@L["CmsLabelAr"]<input asp-for="LabelAr" type="text" maxlength="120" dir="rtl" class="cms-input"></label><label class="cms-field">@L["CmsValueEn"]<input asp-for="ValueEn" type="text" maxlength="1000" dir="ltr" class="cms-input"></label><label class="cms-field">@L["CmsValueAr"]<input asp-for="ValueAr" type="text" maxlength="1000" dir="rtl" class="cms-input"></label></div><div class="mt-4 flex flex-wrap gap-2 border-t border-line pt-3"><button type="button" data-row-up class="cms-small">@L["CmsUp"]</button><button type="button" data-row-down class="cms-small">@L["CmsDown"]</button><button type="button" data-row-remove class="cms-small">@L["CmsRemove"]</button><button type="button" draggable="true" data-row-drag class="cms-small" aria-label="@L["CmsOrder"]">↕</button></div></article>