@model NLOIQ.Application.Content.SiteEdit
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{var choices=(NLOIQ.Application.Content.EditorChoices)ViewData["Choices"]!;}
<section class="cms-panel"><h2 class="mb-5 text-xl">@L["SiteTitle"]</h2><div class="grid gap-5 md:grid-cols-2"><label class="cms-field">@L["SiteName"]<input asp-for="SiteName" required maxlength="160" class="cms-input"></label><label class="cms-field">@L["SiteBaseUrl"]<input asp-for="PublicBaseUrl" maxlength="500" placeholder="https://your-domain" class="cms-input" dir="ltr"></label><label class="cms-field">@L["SiteCulture"]<select asp-for="DefaultCulture" class="cms-input"><option value="en">English</option><option value="ar">العربية</option></select></label><label class="cms-field">@L["SiteTheme"]<select asp-for="DefaultTheme" class="cms-input"><option value="system">@L["System"]</option><option value="light">@L["Light"]</option><option value="dark">@L["Dark"]</option></select></label><label class="cms-field">@L["SiteLogo"]<select asp-for="LogoAssetId" class="cms-input"><option value="">@L["CmsNone"]</option>@foreach(var asset in choices.Media){<option value="@asset.Id" data-alt-en="@asset.AltEn" data-alt-ar="@asset.AltAr">#@asset.Id / @asset.Label</option>}</select></label><label class="cms-field">@L["SiteFavicon"]<select asp-for="FaviconAssetId" class="cms-input"><option value="">@L["CmsNone"]</option>@foreach(var asset in choices.Media){<option value="@asset.Id">#@asset.Id / @asset.Label</option>}</select></label><label class="cms-field">@L["CmsAltEn"]<input asp-for="LogoAltEn" maxlength="500" dir="ltr" class="cms-input"></label><label class="cms-field">@L["CmsAltAr"]<input asp-for="LogoAltAr" maxlength="500" dir="rtl" class="cms-input"></label></div><p class="mt-5 text-xs leading-6 text-muted">@L["SiteLogoHint"]</p></section>
