@model NLOIQ.Application.Content.MediaEdit
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
<article data-row class="cms-row">@{ var choices=(NLOIQ.Application.Content.EditorChoices)ViewData["Choices"]!; }<div class="grid gap-4 md:grid-cols-2"><label class="cms-field">@L["CmsImages"]<select asp-for="AssetId" class="cms-input">@foreach(var asset in choices.Media){<option value="@asset.Id" data-alt-en="@asset.AltEn" data-alt-ar="@asset.AltAr">#@asset.Id / @asset.Label @(asset.IsDemo?" / "+L["CmsDemo"]:"")</option>}</select></label><label class="cms-field">@L["CmsUsage"]<input asp-for="UsageKey" type="text" maxlength="40" class="cms-input"></label><label class="cms-field">@L["CmsAltEn"]<input asp-for="AltEn" type="text" maxlength="500" dir="ltr" class="cms-input"></label><label class="cms-field">@L["CmsAltAr"]<input asp-for="AltAr" type="text" maxlength="500" dir="rtl" class="cms-input"></label><label class="cms-field">@L["CmsCaptionEn"]<input asp-for="CaptionEn" type="text" maxlength="1000" dir="ltr" class="cms-input"></label><label class="cms-field">@L["CmsCaptionAr"]<input asp-for="CaptionAr" type="text" maxlength="1000" dir="rtl" class="cms-input"></label></div><div class="mt-4 flex flex-wrap gap-2 border-t border-line pt-3"><button type="button" data-row-up class="cms-small">@L["CmsUp"]</button><button type="button" data-row-down class="cms-small">@L["CmsDown"]</button><button type="button" data-row-remove class="cms-small">@L["CmsRemove"]</button><button type="button" draggable="true" data-row-drag class="cms-small" aria-label="@L["CmsOrder"]">↕</button></div></article>