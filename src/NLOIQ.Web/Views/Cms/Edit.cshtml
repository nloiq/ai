@model NLOIQ.Application.Content.ContentEdit
@using NLOIQ.Domain.Content
@using NLOIQ.Application.Content
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{ Layout="_AdminLayout"; ViewData["Title"]=L["CmsEdit"]; var culture=Context.Request.RouteValues["culture"]?.ToString(); var choices=(EditorChoices)ViewData["Choices"]!; var item=ViewData["Item"] as ContentListRow;
Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary PrefixData(string prefix){var data=new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData);data.TemplateInfo.HtmlFieldPrefix=prefix;return data;}
Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary RowData(string collection,int index){var data=new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData);data.TemplateInfo.HtmlFieldPrefix=collection+"["+index+"]";return data;}
}
<a href="/@culture/admin/content" class="inline-flex min-h-11 items-center text-sm underline underline-offset-4">@L["CmsBack"]</a><div class="my-5 flex flex-wrap items-end justify-between gap-4"><div><p class="text-xs text-signal">@L["CmsKind"+Model.Kind] / @Model.Key</p><h1 class="mt-3 text-3xl">@L["CmsEdit"]</h1></div>@if(item is not null){<p class="text-sm text-muted">@L["Cms"+item.State] · @L["CmsRevision"] @item.Revision</p>}</div>
@if(TempData["CmsNotice"] is string notice){<p role="status" class="mb-6 border border-line bg-panel p-4 text-signal">@notice</p>}
@if(TempData["CmsError"] is string error){<p role="alert" class="mb-6 border border-accent p-4">@error</p>}
@if(ViewData["PublishedPath"] is string live){<a href="@live" class="mb-6 inline-flex min-h-11 items-center text-sm underline underline-offset-4">@L["CmsViewPublished"]</a>}
<form method="post" asp-antiforgery="true" id="cms-editor" class="space-y-8">
<input asp-for="Id" type="hidden"><input asp-for="Version" type="hidden"><input asp-for="Kind" type="hidden">
<div asp-validation-summary="All" class="text-accent" role="alert"></div>
<section class="border border-line bg-panel p-5"><label class="cms-field">@L["CmsKey"]<input asp-for="Key" readonly="@(Model.Id!=0)" required maxlength="80" pattern="[a-z0-9]+(-[a-z0-9]+)*" class="cms-input" dir="ltr"></label><p class="mt-3 text-xs leading-6 text-muted">@L["CmsNewHint"]</p></section>
<div class="flex flex-wrap gap-2" role="tablist" hidden data-translation-tabs><button type="button" role="tab" id="english-tab" aria-controls="english-panel" aria-selected="true" data-tab="english-panel" class="cms-small">@L["CmsEnglish"]</button><button type="button" role="tab" id="arabic-tab" aria-controls="arabic-panel" aria-selected="false" data-tab="arabic-panel" class="cms-small">@L["CmsArabic"]</button></div>
<section id="english-panel" data-translation-panel class="border border-line p-5"><h2 class="mb-5 text-xl">@L["CmsEnglish"]</h2><div class="grid gap-5"><label class="cms-field">@L["CmsTitleField"]<input asp-for="English.Title" lang="en" dir="ltr" type="text" maxlength="200" class="cms-input"></label><label class="cms-field">@L["CmsSummary"]<input asp-for="English.Summary" lang="en" dir="ltr" type="text" maxlength="2000" class="cms-input"></label><div><label class="cms-field" for="English_Body">@L["CmsBody"]</label><div class="my-2 flex flex-wrap gap-2" data-format-for="English_Body"><button type="button" data-format="bold" class="cms-small">@L["CmsBold"]</button><button type="button" data-format="italic" class="cms-small">@L["CmsItalic"]</button><button type="button" data-format="list" class="cms-small">@L["CmsList"]</button><button type="button" data-format="link" class="cms-small">@L["CmsLink"]</button></div><textarea asp-for="English.Body" lang="en" dir="ltr" maxlength="16000" rows="9" class="cms-input"></textarea><p class="mt-2 text-xs leading-6 text-muted">@L["CmsFormatting"]</p></div>@if(Model.Kind is ContentKind.Page or ContentKind.Project){<label class="cms-field">@L["CmsSlug"]<input asp-for="English.Slug" lang="en" dir="ltr" type="text" maxlength="160" class="cms-input"></label>}@if(Model.Kind==ContentKind.Section){<div class="grid gap-4 md:grid-cols-2"><label class="cms-field">@L["CmsPrimaryLabel"]<input asp-for="English.PrimaryButtonLabel" lang="en" dir="ltr" type="text" maxlength="120" class="cms-input"></label><label class="cms-field">@L["CmsSecondaryLabel"]<input asp-for="English.SecondaryButtonLabel" lang="en" dir="ltr" type="text" maxlength="120" class="cms-input"></label></div>}@if(Model.Kind is ContentKind.Page or ContentKind.Project){<partial name="_SeoFields" model="Model.SeoEnglish" view-data='PrefixData("SeoEnglish")' />}</div></section>
<section id="arabic-panel" data-translation-panel class="border border-line p-5"><h2 class="mb-5 text-xl">@L["CmsArabic"]</h2><div class="grid gap-5"><label class="cms-field">@L["CmsTitleField"]<input asp-for="Arabic.Title" lang="ar" dir="rtl" type="text" maxlength="200" class="cms-input"></label><label class="cms-field">@L["CmsSummary"]<input asp-for="Arabic.Summary" lang="ar" dir="rtl" type="text" maxlength="2000" class="cms-input"></label><div><label class="cms-field" for="Arabic_Body">@L["CmsBody"]</label><div class="my-2 flex flex-wrap gap-2" data-format-for="Arabic_Body"><button type="button" data-format="bold" class="cms-small">@L["CmsBold"]</button><button type="button" data-format="italic" class="cms-small">@L["CmsItalic"]</button><button type="button" data-format="list" class="cms-small">@L["CmsList"]</button><button type="button" data-format="link" class="cms-small">@L["CmsLink"]</button></div><textarea asp-for="Arabic.Body" lang="ar" dir="rtl" maxlength="16000" rows="9" class="cms-input"></textarea><p class="mt-2 text-xs leading-6 text-muted">@L["CmsFormatting"]</p></div>@if(Model.Kind is ContentKind.Page or ContentKind.Project){<label class="cms-field">@L["CmsSlug"]<input asp-for="Arabic.Slug" lang="ar" dir="rtl" type="text" maxlength="160" class="cms-input"></label>}@if(Model.Kind==ContentKind.Section){<div class="grid gap-4 md:grid-cols-2"><label class="cms-field">@L["CmsPrimaryLabel"]<input asp-for="Arabic.PrimaryButtonLabel" lang="ar" dir="rtl" type="text" maxlength="120" class="cms-input"></label><label class="cms-field">@L["CmsSecondaryLabel"]<input asp-for="Arabic.SecondaryButtonLabel" lang="ar" dir="rtl" type="text" maxlength="120" class="cms-input"></label></div>}@if(Model.Kind is ContentKind.Page or ContentKind.Project){<partial name="_SeoFields" model="Model.SeoArabic" view-data='PrefixData("SeoArabic")' />}</div></section>
@if(Model.Kind==ContentKind.SiteSettings){<partial name="_SiteFields" model="Model.Site" view-data='PrefixData("Site")' />}
@if(Model.Kind==ContentKind.ThemeSettings){<partial name="_ThemeFields" model="Model.Theme" view-data='PrefixData("Theme")' />}
@if(Model.Kind==ContentKind.Section){<section class="cms-panel"><h2 class="mb-5 text-xl">@L["CmsKindSection"]</h2><div class="grid gap-5 md:grid-cols-2"><label class="cms-field">@L["CmsSectionKind"]<select asp-for="SectionKind" class="cms-input">@foreach(var kind in Enum.GetValues<SectionKind>()){<option value="@kind">@L["CmsSection"+kind]</option>}</select></label><label class="cms-field">@L["CmsLayout"]<select asp-for="LayoutKey" class="cms-input">@foreach(var layout in new[]{"default","folio","wide","numbered"}){<option value="@layout">@L["OptionLayout"+layout]</option>}</select></label><label class="cms-field">@L["CmsBackground"]<select asp-for="Background" class="cms-input">@foreach(var background in new[]{"paper","panel","evergreen"}){<option value="@background">@L["OptionBackground"+background]</option>}</select></label><label class="cms-field">@L["CmsParallax"]<input asp-for="ParallaxIntensity" type="number" min="0" max="1" step="0.01" class="cms-input"></label><label class="cms-field">@L["CmsPrimaryTarget"]<input asp-for="PrimaryButtonTarget" type="text" maxlength="500" dir="ltr" class="cms-input"></label><label class="cms-field">@L["CmsSecondaryTarget"]<input asp-for="SecondaryButtonTarget" type="text" maxlength="500" dir="ltr" class="cms-input"></label></div></section>}@if(Model.Kind is ContentKind.Section or ContentKind.Service){<label class="flex min-h-11 items-center gap-3"><input asp-for="IsVisible">@L["CmsVisible"]</label>}
@if(Model.Kind is ContentKind.Project or ContentKind.Service){<label class="cms-field">@L["CmsOrder"]<input asp-for="DisplayOrder" type="number" min="0" max="99999" class="cms-input"></label>}@if(Model.Kind==ContentKind.Project){<section class="cms-panel"><div class="grid gap-5 md:grid-cols-2"><label class="cms-field">@L["CmsVideo"]<input asp-for="YouTubeVideoId" type="text" maxlength="11" dir="ltr" class="cms-input"></label><label class="flex min-h-11 items-center gap-3"><input asp-for="IsFeatured">@L["CmsFeatured"]</label></div><label class="cms-field mt-5">@L["CmsCategories"]<select asp-for="Categories" multiple class="cms-input min-h-28">@foreach(var category in choices.Categories){<option value="@category.Id">@category.Label</option>}</select></label></section>}
@if(Model.Kind==ContentKind.Service){<label class="cms-field">@L["CmsIcon"]<select asp-for="IconKey" class="cms-input">@foreach(var icon in new[]{"network","code","monitor","logic"}){<option value="@icon">@L["OptionIcon"+icon]</option>}</select></label>}
@if(Model.Kind==ContentKind.Footer){<label class="flex min-h-11 items-center gap-3"><input asp-for="ShowCopyright">@L["CmsCopyright"]</label>}
@if(Model.Kind==ContentKind.Page){<section class="cms-panel" data-collection="Sections"><h2 class="text-xl">@L["CmsSections"]</h2><p class="my-4 text-sm leading-7 text-muted">@L["CmsPinned"]</p><div data-rows class="mt-5 space-y-4">@for(var i=0;i<Model.Sections.Count;i++){<partial name="_SectionRow" model="Model.Sections[i]" view-data='RowData("Sections",i)' />}</div><template data-row-template><partial name="_SectionRow" model="new SectionEdit()" view-data='RowData("Sections",0)' /></template><button type="button" data-row-add class="cms-small mt-5">+ @L["CmsAdd"]</button></section>}
@if(Model.Kind is ContentKind.Page or ContentKind.Section or ContentKind.Project or ContentKind.Service){<section class="cms-panel" data-collection="Media"><h2 class="text-xl">@L["CmsImages"]</h2><p class="my-4 text-sm leading-7 text-muted">@L["CmsMediaHint"]</p><div data-rows class="mt-5 space-y-4">@for(var i=0;i<Model.Media.Count;i++){<partial name="_MediaRow" model="Model.Media[i]" view-data='RowData("Media",i)' />}</div><template data-row-template><partial name="_MediaRow" model="new MediaEdit()" view-data='RowData("Media",0)' /></template><button type="button" data-row-add class="cms-small mt-5">+ @L["CmsAdd"]</button></section>}
@if(Model.Kind==ContentKind.Navigation){<section class="cms-panel" data-collection="Links"><h2 class="text-xl">@L["CmsLinks"]</h2><div data-rows class="mt-5 space-y-4">@for(var i=0;i<Model.Links.Count;i++){<partial name="_NavigationRow" model="Model.Links[i]" view-data='RowData("Links",i)' />}</div><template data-row-template><partial name="_NavigationRow" model="new NavigationEdit()" view-data='RowData("Links",0)' /></template><button type="button" data-row-add class="cms-small mt-5">+ @L["CmsAdd"]</button></section>}
@if(Model.Kind==ContentKind.Contact){<section class="cms-panel" data-collection="Contacts"><h2 class="text-xl">@L["CmsContacts"]</h2><div data-rows class="mt-5 space-y-4">@for(var i=0;i<Model.Contacts.Count;i++){<partial name="_ContactRow" model="Model.Contacts[i]" view-data='RowData("Contacts",i)' />}</div><template data-row-template><partial name="_ContactRow" model="new ContactEdit()" view-data='RowData("Contacts",0)' /></template><button type="button" data-row-add class="cms-small mt-5">+ @L["CmsAdd"]</button></section>}
@if(Model.Kind is ContentKind.Contact or ContentKind.Footer or ContentKind.SiteSettings){<section class="cms-panel" data-collection="Social"><h2 class="text-xl">@L["CmsSocial"]</h2><div data-rows class="mt-5 space-y-4">@for(var i=0;i<Model.Social.Count;i++){<partial name="_SocialRow" model="Model.Social[i]" view-data='RowData("Social",i)' />}</div><template data-row-template><partial name="_SocialRow" model="new SocialEdit()" view-data='RowData("Social",0)' /></template><button type="button" data-row-add class="cms-small mt-5">+ @L["CmsAdd"]</button></section>}
@if(Model.Kind==ContentKind.Contact){<section class="cms-panel" data-collection="Hours"><h2 class="text-xl">@L["CmsHours"]</h2><div data-rows class="mt-5 space-y-4">@for(var i=0;i<Model.Hours.Count;i++){<partial name="_HoursRow" model="Model.Hours[i]" view-data='RowData("Hours",i)' />}</div><template data-row-template><partial name="_HoursRow" model="new HoursEdit()" view-data='RowData("Hours",0)' /></template><button type="button" data-row-add class="cms-small mt-5">+ @L["CmsAdd"]</button></section>}
<section class="cms-panel"><label class="cms-field">@L["CmsNote"]<input asp-for="ChangeNote" type="text" maxlength="500" class="cms-input"></label><div class="mt-5 flex flex-wrap items-center gap-4"><button type="submit" class="min-h-12 bg-accent px-6 font-semibold text-on-accent">@L["CmsSave"]</button>@if(Model.Id!=0){<a href="/@culture/admin/content/@Model.Id" class="inline-flex min-h-11 items-center text-sm underline underline-offset-4">@L["CmsReload"]</a>}</div></section></form>
@if(Model.Id!=0 && item?.Version==Model.Version && User.IsInRole("SuperAdmin")){<section class="mt-10 border border-accent p-5"><h2 class="text-xl">@L["CmsPublication"]</h2><p class="mt-3 text-sm leading-7 text-muted">@L["CmsPublishHint"]</p><form method="post" action="/@culture/admin/content/@Model.Id/status" asp-antiforgery="true" class="mt-5"><input type="hidden" name="version" value="@item!.Version"><label class="flex items-start gap-3 text-sm leading-7"><input type="checkbox" name="verified" value="true" class="mt-2">@L["CmsVerify"]</label><div class="mt-5 flex flex-wrap gap-3"><button name="action" value="publish" class="min-h-11 bg-accent px-4 text-on-accent">@L["CmsPublish"]</button><button name="action" value="unpublish" class="cms-small">@L["CmsUnpublish"]</button><button name="action" value="archive" class="cms-small">@L["CmsArchive"]</button></div></form><p class="mt-4 text-xs leading-6 text-muted">@L["CmsArchiveHint"]</p></section>}
