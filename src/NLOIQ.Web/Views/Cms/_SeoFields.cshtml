@model NLOIQ.Application.Content.SeoEdit
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{var language=ViewData.TemplateInfo.HtmlFieldPrefix=="SeoArabic"?"ar":"en";var direction=language=="ar"?"rtl":"ltr";}
<section class="mt-6 border-t border-line pt-5" id="seo-@(ViewData.TemplateInfo.HtmlFieldPrefix=="SeoArabic"?"Arabic":"English")"><h3 class="text-xl">@L["SeoTitle"]</h3><p class="my-4 text-xs leading-6 text-muted">@L["SeoHint"]</p><div class="grid gap-4 md:grid-cols-2"><label class="cms-field">@L["SeoMetaTitle"]<input asp-for="Title" lang="@language" dir="@direction" maxlength="200" class="cms-input"></label><label class="cms-field">@L["SeoDescription"]<textarea asp-for="Description" lang="@language" dir="@direction" maxlength="320" rows="3" class="cms-input"></textarea></label><label class="cms-field">@L["SeoOgTitle"]<input asp-for="OpenGraphTitle" lang="@language" dir="@direction" maxlength="200" class="cms-input"></label><label class="cms-field">@L["SeoOgDescription"]<textarea asp-for="OpenGraphDescription" lang="@language" dir="@direction" maxlength="320" rows="3" class="cms-input"></textarea></label><label class="cms-field">@L["SeoImage"]<input asp-for="OpenGraphUsageKey" maxlength="40" placeholder="cover" class="cms-input" dir="ltr"></label><label class="cms-field">@L["SeoCanonical"]<input asp-for="CanonicalPath" maxlength="500" placeholder="/en/pages/example" class="cms-input" dir="ltr"></label><label class="flex min-h-11 items-center gap-3"><input asp-for="NoIndex">@L["SeoNoIndex"]</label></div></section>
