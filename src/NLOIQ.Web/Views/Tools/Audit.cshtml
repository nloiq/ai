@model IReadOnlyList<NLOIQ.Domain.Content.AuditLog>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{Layout="_AdminLayout";ViewData["Title"]=L["AuditTitle"];var culture=Context.Request.RouteValues["culture"]?.ToString();var page=int.TryParse(Context.Request.Query["page"],out var current)?Math.Max(1,current):1;}
<h1 class="text-3xl">@L["AuditTitle"]</h1><p class="mt-4 text-sm text-muted">@L["AuditHelp"]</p><form method="get" class="my-6 flex flex-wrap items-end gap-3"><label class="cms-field">@L["AuditContent"]<input name="contentId" type="number" min="1" value="@Context.Request.Query["contentId"]" class="cms-input"></label><button class="cms-small">@L["CmsFilter"]</button></form><div class="space-y-4">@foreach(var entry in Model){<article class="min-w-0 border border-line bg-panel p-5"><div class="flex flex-wrap justify-between gap-3"><h2 class="font-semibold">#@entry.Id · @(L["AuditAction"+entry.Action].ResourceNotFound?L["AuditActionOther"]:L["AuditAction"+entry.Action])</h2><time datetime="@entry.OccurredUtc.ToString("O")" class="text-sm" dir="ltr">@entry.OccurredUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</time></div><dl class="mt-4 grid gap-3 text-sm md:grid-cols-3"><div><dt class="text-muted">@L["AuditActor"]</dt><dd class="break-words"><bdi>@entry.ActorLabel</bdi></dd></div><div><dt class="text-muted">@L["AuditContent"]</dt><dd>@entry.ContentItemId</dd></div><div><dt class="text-muted">@L["CmsRevision"]</dt><dd>@entry.RevisionId</dd></div></dl>@if(entry.DetailsJson is not null){<details class="mt-4 text-xs"><summary class="cursor-pointer">@L["AuditDetails"]</summary><pre class="mt-3 whitespace-pre-wrap break-all" dir="ltr">@entry.DetailsJson</pre></details>}</article>}</div>@if(Model.Count==0){<p>@L["AuditEmpty"]</p>}<nav class="mt-6 flex gap-4">@if(page>1){<a class="cms-small" href="?page=@(page-1)&contentId=@Context.Request.Query["contentId"]">@L["MediaPrevious"]</a>}@if(Model.Count==50){<a class="cms-small" href="?page=@(page+1)&contentId=@Context.Request.Query["contentId"]">@L["MediaNext"]</a>}</nav>
