@model NLOIQ.Web.Models.TranslationReviewPage
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{ Layout="_AdminLayout";ViewData["Title"]=L["TranslationsTitle"];var culture=Context.Request.RouteValues["culture"]?.ToString(); }
<h1 class="text-3xl">@L["TranslationsTitle"]</h1><p class="mt-4 max-w-3xl text-sm leading-7 text-muted">@L["TranslationsHelp"]</p>
<form method="get" class="my-6 flex flex-wrap items-end gap-3"><label class="cms-field">@L["CmsSearch"]<input name="search" value="@Context.Request.Query["search"]" maxlength="80" dir="ltr" class="cms-input"></label><button class="cms-small">@L["CmsFilter"]</button></form>
<div class="grid gap-5 xl:grid-cols-2">@foreach(var row in Model.Rows){<article data-translation-row class="min-w-0 border border-line bg-panel p-5"><div class="flex flex-wrap justify-between gap-3 text-xs text-muted"><span>@L["CmsKind"+row.Kind] / <bdi dir="ltr">@row.Key</bdi></span><span>@L["Cms"+row.State] @(row.IsDemo?" · "+L["CmsDemo"]:"")</span></div><div class="mt-5 grid gap-5 md:grid-cols-2">@foreach(var language in new[]{"en","ar"}){var missing=language=="en"?row.EnglishMissing:row.ArabicMissing;var title=language=="en"?row.EnglishTitle:row.ArabicTitle;<section class="min-w-0"><h2 class="text-sm font-semibold">@L[language=="en"?"CmsEnglish":"CmsArabic"]</h2><p lang="@language" dir="@(language=="ar"?"rtl":"ltr")" class="mt-3 break-words">@(string.IsNullOrWhiteSpace(title)?L["TranslationsNoTitle"].Value:title)</p><p class="mt-3 text-xs text-signal">@L[missing.Count==0?"TranslationsReady":"TranslationsMissing"]</p>@if(missing.Count>0){<ul class="mt-2 list-inside list-disc text-xs leading-7">@foreach(var field in missing){<li>@L["Translation"+field]</li>}</ul>}<a href="/@culture/admin/content/@row.Id#@(language=="en"?"english":"arabic")-panel" class="mt-3 inline-flex min-h-11 items-center text-sm underline">@L["TranslationsEdit"]</a></section>}</div></article>}</div>
@if(Model.Rows.Count==0){<p>@L["CmsEmpty"]</p>}
<nav class="mt-6 flex gap-4">@if(Model.Page>1){<a class="cms-small" href="?page=@(Model.Page-1)&search=@Context.Request.Query["search"]">@L["MediaPrevious"]</a>}@if(Model.HasNext){<a class="cms-small" href="?page=@(Model.Page+1)&search=@Context.Request.Query["search"]">@L["MediaNext"]</a>}</nav>
