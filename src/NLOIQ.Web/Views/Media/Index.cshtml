@model IReadOnlyList<NLOIQ.Application.Content.MediaRow>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{Layout="_AdminLayout";ViewData["Title"]=L["MediaTitle"];var culture=Context.Request.RouteValues["culture"]?.ToString();var page=int.TryParse(Context.Request.Query["page"],out var current)?Math.Max(1,current):1;}
<h1 class="text-3xl">@L["MediaTitle"]</h1><p class="mt-4 max-w-3xl text-sm leading-7 text-muted">@L["MediaHelp"]</p>
@if(TempData["MediaNotice"] is string notice){<p role="status" class="my-5 border border-line bg-panel p-4 text-signal">@notice</p>}
@if(TempData["MediaError"] is string error){<p role="alert" class="my-5 border border-accent p-4">@error</p>}
<form method="post" enctype="multipart/form-data" action="/@culture/admin/media/upload" asp-antiforgery="true" class="my-8 border border-line p-5" id="media-upload"><h2 class="text-xl">@L["MediaUpload"]</h2><div class="mt-5 grid gap-5 md:grid-cols-2"><label class="cms-field md:col-span-2">@L["MediaFile"]<input type="file" name="image" accept="image/png,image/jpeg,image/webp" required class="cms-input"></label><label class="cms-field">@L["CmsAltEn"]<input name="altEn" required maxlength="500" dir="ltr" class="cms-input"></label><label class="cms-field">@L["CmsAltAr"]<input name="altAr" required maxlength="500" dir="rtl" class="cms-input"></label></div><button class="mt-5 min-h-11 bg-accent px-5 text-on-accent">@L["MediaUpload"]</button></form>
<form method="get" class="mb-6 flex flex-wrap gap-3"><input name="search" maxlength="255" value="@Context.Request.Query["search"]" aria-label="@L["CmsSearch"]" class="min-h-11 border border-line bg-paper px-3"><button class="cms-small">@L["CmsFilter"]</button></form><p class="mb-6 text-sm text-muted">@L["MediaAltHelp"]</p>
<div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">@foreach(var asset in Model){<article data-media-id="@asset.Id" class="min-w-0 border border-line bg-panel p-4"><img src="/@culture/admin/media/@asset.Id/preview" alt="@(culture=="ar"?asset.AltAr:asset.AltEn)" width="@(asset.Width??320)" height="@(asset.Height??200)" loading="lazy" class="aspect-video w-full object-contain"><h2 class="mt-4 break-words font-semibold">@asset.Name</h2><p class="mt-2 text-xs text-muted">#@asset.Id · @asset.Width × @asset.Height · @((asset.Bytes/1024d).ToString("0.0")) KiB</p><p class="mt-2 text-xs text-signal">@(asset.InUse?L["MediaUsed"]:L["MediaUnused"]) @(asset.IsDemo?" / "+L["CmsDemo"]:"")</p><details class="mt-4"><summary class="min-h-11 cursor-pointer text-sm">@L["MediaSaveAlt"]</summary><form method="post" action="/@culture/admin/media/@asset.Id/alt" asp-antiforgery="true" class="space-y-4"><input type="hidden" name="version" value="@asset.Version"><label class="cms-field">@L["CmsAltEn"]<input name="altEn" value="@asset.AltEn" dir="ltr" required maxlength="500" class="cms-input"></label><label class="cms-field">@L["CmsAltAr"]<input name="altAr" value="@asset.AltAr" dir="rtl" required maxlength="500" class="cms-input"></label><button class="cms-small">@L["MediaSaveAlt"]</button></form></details>@if(User.IsInRole("SuperAdmin")&&!asset.InUse){<form method="post" action="/@culture/admin/media/@asset.Id/delete" asp-antiforgery="true" class="mt-4"><button class="cms-small">@L["MediaDelete"]</button></form>}</article>}</div>
@if(Model.Count==0){<p>@L["MediaEmpty"]</p>}
<nav class="mt-6 flex flex-wrap gap-5" aria-label="@L["MediaTitle"]">@if(page>1){<a href="?page=@(page-1)&search=@Context.Request.Query["search"]" class="cms-small">@L["MediaPrevious"]</a>}@if(Model.Count==30){<a href="?page=@(page+1)&search=@Context.Request.Query["search"]" class="cms-small">@L["MediaNext"]</a>}</nav>
