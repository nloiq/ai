@model NLOIQ.Application.Content.PublicSite
@using NLOIQ.Application.Content
@using NLOIQ.Domain.Content
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{var culture=Model.Culture;var ar=culture=="ar";var alternate=ar?"en":"ar";var firstHero=Model.Sections.FirstOrDefault(x=>x.SectionKind==SectionKind.Hero);ViewData["Culture"]=culture;ViewData["CmsProjects"]=true;}
<!doctype html><html lang="@culture" dir="@(ar?"rtl":"ltr")"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="@Model.Page.Summary"><meta name="robots" content="noindex,nofollow"><title>@Model.Page.Title · NLO IQ</title><script src="~/js/theme-init.js" asp-append-version="true"></script><link rel="stylesheet" href="~/css/app.css" asp-append-version="true"><script src="~/js/app.js" asp-append-version="true" defer></script><script src="~/js/motion.mjs" asp-append-version="true" type="module"></script><script src="~/js/project-dialog.mjs" asp-append-version="true" type="module"></script></head>
<body class="bg-paper text-ink antialiased"><a href="#main" class="sr-only focus:not-sr-only focus:block focus:p-4">@L["Skip"]</a>
<header id="site-header" class="sticky top-0 z-30 border-b border-line bg-paper/95"><div class="mx-auto flex max-w-[1500px] flex-wrap items-center justify-between gap-4 px-5 py-4 md:px-10"><a href="/@culture/" class="border border-ink px-3 py-2 text-xl font-bold" dir="ltr">NLO IQ</a><div class="ms-auto flex items-center gap-3 text-sm lg:order-3 lg:ms-0"><a href="@Model.AlternateUrl" lang="@alternate" class="inline-flex min-h-11 items-center underline underline-offset-4">@(ar?"English":"العربية")</a><select id="theme" aria-label="@L["Theme"]" class="min-h-11 max-w-28 border border-line bg-paper px-2"><option value="system">@L["System"]</option><option value="light">@L["Light"]</option><option value="dark">@L["Dark"]</option></select><button id="menu-toggle" type="button" hidden aria-expanded="false" aria-controls="primary-navigation" class="min-h-11 border border-line px-3 lg:hidden">@L["Menu"]</button></div><nav id="primary-navigation" aria-label="@L["Navigation"]" class="flex basis-full flex-wrap gap-x-6 gap-y-2 text-sm lg:basis-auto">@if(Model.Navigation is not null){foreach(var link in Model.Navigation.Links){<a href="@link.Href" class="inline-flex min-h-11 items-center @(link.Depth>0?"ps-4":"")">@link.Label</a>}}</nav></div></header>
<main id="main">
@if(firstHero is null){<header class="mx-auto max-w-[1500px] px-5 py-16 md:px-10"><p class="text-xs uppercase tracking-widest text-signal">NLO IQ</p><h1 class="mt-5 max-w-4xl font-editorial text-5xl md:text-7xl">@Model.Page.Title</h1><p class="mt-6 max-w-2xl text-muted">@Model.Page.Summary</p><div class="cms-body mt-6 max-w-3xl leading-8">@Html.Raw(ContentMarkup.Render(Model.Page.Body))</div>@foreach(var image in Model.Page.Images){<figure class="mt-8"><img src="@image.Url" alt="@image.Alt" width="@image.Width" height="@image.Height" loading="lazy" class="max-h-[650px] w-full object-contain">@if(image.Caption is not null){<figcaption class="mt-3 text-sm text-muted">@image.Caption</figcaption>}</figure>}</header>}
@if(firstHero is not null && !string.IsNullOrWhiteSpace(Model.Page.Body)){<div class="cms-body mx-auto max-w-[1500px] px-5 pt-10 leading-8 md:px-10">@Html.Raw(ContentMarkup.Render(Model.Page.Body))</div>}
@foreach(var block in Model.Sections){var anchor=block.SectionKind==SectionKind.Services?"expertise":block.Key;var dark=block.Background=="evergreen";
<section id="@anchor" class="scroll-mt-32 px-5 py-16 md:px-10 lg:py-24 @(dark?"bg-evergreen text-ivory":block.Background=="panel"?"bg-panel":"bg-paper")" data-layout="@block.Layout"><div class="mx-auto max-w-[1500px]">
<div data-reveal class="grid gap-8 @(block.Layout=="wide"?"":"md:grid-cols-[1.3fr_1fr]")"><div><p class="text-xs uppercase tracking-widest @(dark?"text-gold":"text-signal")">@(block.Layout=="numbered"?$"{Model.Sections.ToList().IndexOf(block)+1:00} / ":"")@L["CmsSection"+block.SectionKind]</p>
@if(firstHero?.Id==block.Id){<h1 data-parallax="@Math.Round(block.Parallax*12)" class="mt-5 max-w-4xl font-editorial text-[clamp(3rem,6vw,6rem)] leading-tight">@block.Title</h1>}else{<h2 class="mt-5 max-w-3xl font-editorial text-[clamp(2.5rem,4.5vw,4.5rem)] leading-tight">@block.Title</h2>}</div><div class="max-w-2xl self-end text-sm leading-7 @(dark?"text-ivory/80":"text-muted")"><p>@block.Summary</p><div class="cms-body">@Html.Raw(ContentMarkup.Render(block.Body))</div></div></div>
@if(block.Images.Count>0){<div class="mt-8 grid gap-5 md:grid-cols-2">@foreach(var image in block.Images){<figure data-parallax="@Math.Round(block.Parallax*20)"><img src="@image.Url" alt="@image.Alt" width="@image.Width" height="@image.Height" loading="lazy" class="w-full object-cover">@if(image.Caption is not null){<figcaption class="mt-3 text-sm">@image.Caption</figcaption>}</figure>}</div>}
<div class="mt-6 flex flex-wrap gap-5">@if(!string.IsNullOrWhiteSpace(block.PrimaryLabel)&&!string.IsNullOrWhiteSpace(block.PrimaryTarget)){<a href="@block.PrimaryTarget.Replace("{culture}",culture)" class="inline-flex min-h-12 items-center bg-accent px-5 text-on-accent">@block.PrimaryLabel</a>}@if(!string.IsNullOrWhiteSpace(block.SecondaryLabel)&&!string.IsNullOrWhiteSpace(block.SecondaryTarget)){<a href="@block.SecondaryTarget.Replace("{culture}",culture)" class="inline-flex min-h-12 items-center border-b border-current">@block.SecondaryLabel</a>}</div>
@if(block.SectionKind==SectionKind.Hero && block.Images.Count==0){<svg aria-hidden="true" data-parallax="@Math.Round(block.Parallax*24)" viewBox="0 0 1000 180" fill="none" class="mt-10 w-full text-signal"><path d="M0 90H100 M300 90H400 M600 90H700 M900 90H1000 M200 140V170H800V140" stroke="currentColor" stroke-width="2"/><rect x="100" y="40" width="200" height="100" stroke="currentColor"/><rect x="400" y="40" width="200" height="100" stroke="currentColor"/><rect x="700" y="40" width="200" height="100" stroke="currentColor"/><path d="M150 90H250 M200 65V115 M450 65H550V115H450Z M750 75H850 M750 105H850" stroke="currentColor" stroke-width="2"/></svg>}
@if(block.SectionKind==SectionKind.Projects){<partial name="_CmsProjects" model="Model.Projects" />}
@if(block.SectionKind==SectionKind.Services){<partial name="_CmsServices" model="Model.Services" />}
@if(block.SectionKind==SectionKind.Contact && Model.Contact is not null){<partial name="_CmsContact" model="Model.Contact" />}
</div></section>}
@if(Model.Page.Kind==ContentKind.Project && Model.Page.VideoId is not null){<section class="mx-auto max-w-[1500px] px-5 pb-16 md:px-10"><iframe src="@("https://www.youtube-nocookie.com/embed/"+Model.Page.VideoId+"?autoplay=0&playsinline=1")" title="@Model.Page.Title" loading="lazy" allow="encrypted-media; fullscreen; picture-in-picture" allowfullscreen class="aspect-video w-full border-0"></iframe></section>}
</main>
@if(Model.Footer is not null){<footer class="bg-evergreen px-5 py-14 text-ivory md:px-10"><div class="mx-auto grid max-w-[1500px] gap-8 md:grid-cols-2"><div><h2 class="font-editorial text-4xl">@Model.Footer.Title</h2><p class="mt-5 max-w-xl text-sm leading-7 text-ivory/80">@Model.Footer.Summary</p><div class="cms-body text-sm leading-7">@Html.Raw(ContentMarkup.Render(Model.Footer.Body))</div></div><nav aria-label="@L["FooterNavigation"]" class="flex flex-wrap items-start gap-5">@if(Model.FooterNavigation is not null){foreach(var link in Model.FooterNavigation.Links){<a href="@link.Href" class="inline-flex min-h-11 items-center">@link.Label</a>}}@foreach(var social in Model.Footer.Social){<a href="@social.Href" rel="noopener noreferrer" class="inline-flex min-h-11 items-center underline">@social.Label</a>}</nav>@if(Model.Footer.ShowCopyright){<p class="text-xs" dir="ltr">© @DateTime.UtcNow.Year NLO IQ</p>}</div></footer>}
<partial name="_ProjectDialog" model='new HomeViewModel(culture,Array.Empty<NLOIQ.Application.Interfaces.ServicePreviewDto>(),new Dictionary<string,string?>())' />
</body></html>
