@model NLOIQ.Application.Content.PublicSite
@{ViewData["ContactPreview"]=Model.IsPreview;}
@using NLOIQ.Application.Content
@using NLOIQ.Domain.Content
@inject NLOIQ.Application.Content.IBrandReader BrandReader
@inject IWebHostEnvironment Environment
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{var culture=Model.Culture;var ar=culture=="ar";var alternate=ar?"en":"ar";var firstHero=Model.IsPreview&&Model.Page.Kind==ContentKind.Section?Model.Sections.FirstOrDefault():Model.Sections.FirstOrDefault(x=>x.SectionKind==SectionKind.Hero);ViewData["Culture"]=culture;ViewData["CmsProjects"]=true;var brand=await BrandReader.ReadAsync(culture);var seo=Model.Page.Seo;
var seoTitle=string.IsNullOrWhiteSpace(seo?.Title)?Model.Page.Title+" · "+brand.SiteName:seo.Title;
var seoDescription=string.IsNullOrWhiteSpace(seo?.Description)?Model.Page.Summary:seo.Description;
var canonicalPath=seo?.CanonicalPath??Context.Request.Path.Value??"/";
string Absolute(string path)=>brand.BaseUrl is null?path:new Uri(new Uri(brand.BaseUrl),path).AbsoluteUri;
var canonical=Absolute(canonicalPath);var robots=Model.IsPreview||Environment.IsDevelopment()||seo?.NoIndex!=false?"noindex,nofollow":"index,follow";
}
<!doctype html><html lang="@culture" dir="@(ar?"rtl":"ltr")" data-default-theme="@brand.DefaultTheme"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="@seoDescription"><meta name="robots" content="@robots"><title>@seoTitle</title>@if(!Model.IsPreview){<link rel="canonical" href="@canonical"><link rel="alternate" hreflang="@culture" href="@Absolute(Context.Request.Path.Value??"/")"><link rel="alternate" hreflang="@alternate" href="@Absolute(Model.AlternateUrl)"><link rel="alternate" hreflang="x-default" href="@Absolute(culture==brand.DefaultCulture?(Context.Request.Path.Value??"/"):Model.AlternateUrl)"><meta property="og:locale" content="@(ar?"ar_IQ":"en_US")"><meta property="og:locale:alternate" content="@(ar?"en_US":"ar_IQ")"><meta property="og:title" content="@(string.IsNullOrWhiteSpace(seo?.OpenGraphTitle)?seoTitle:seo.OpenGraphTitle)"><meta property="og:description" content="@(string.IsNullOrWhiteSpace(seo?.OpenGraphDescription)?seoDescription:seo.OpenGraphDescription)"><meta property="og:type" content="website"><meta property="og:url" content="@canonical"><meta property="og:site_name" content="@brand.SiteName">@if(seo?.Image is not null){<meta property="og:image" content="@Absolute(seo.Image.Url)"><meta property="og:image:alt" content="@seo.Image.Alt">}}<script src="~/js/theme-init.js" asp-append-version="true"></script><link rel="stylesheet" href="~/css/app.css" asp-append-version="true"><partial name="_BrandHead" model="brand" /><script src="~/js/app.js" asp-append-version="true" defer></script><script src="~/js/motion.mjs" asp-append-version="true" type="module"></script><script src="~/js/project-dialog.mjs" asp-append-version="true" type="module"></script>@if(Model.Page.Kind==ContentKind.Project){<script src="~/js/project-gallery.js" asp-append-version="true" defer></script>}</head>
<body class="bg-paper text-ink antialiased"><a href="#main" class="sr-only focus:not-sr-only focus:block focus:p-4">@L["Skip"]</a>
@if(Model.IsPreview){<partial name="_PreviewBanner" model="Model" />}
<header id="site-header" class="sticky top-0 z-30 border-b border-line bg-paper/95"><div class="mx-auto flex max-w-[1500px] flex-wrap items-center justify-between gap-4 px-5 py-4 md:px-10"><a href="/@culture/" class="inline-flex min-h-11 items-center" dir="ltr"><partial name="_LogoMark" model="brand" /></a><div class="ms-auto flex items-center gap-3 text-sm lg:order-3 lg:ms-0"><a href="@Model.AlternateUrl" lang="@alternate" class="inline-flex min-h-11 items-center underline underline-offset-4">@(ar?"English":"العربية")</a><partial name="_ThemeSelector" model="brand" /><button id="menu-toggle" type="button" hidden aria-expanded="false" aria-controls="primary-navigation" class="min-h-11 border border-line px-3 lg:hidden">@L["Menu"]</button></div><nav id="primary-navigation" aria-label="@L["Navigation"]" class="flex basis-full flex-wrap gap-x-6 gap-y-2 text-sm lg:basis-auto">@if(Model.Navigation is not null){foreach(var link in Model.Navigation.Links){<a href="@link.Href" class="inline-flex min-h-11 items-center @(link.Depth>0?"ps-4":"")">@link.Label</a>}}</nav></div></header>
<main id="main" tabindex="-1">
@if(Model.Page.Kind==ContentKind.Project){<partial name="_ProjectDetail" model="Model" />}
@if(Model.Page.Kind==ContentKind.Contact){<h1 class="sr-only">@Model.Page.Title</h1>}
@if(firstHero is null && Model.Page.Kind is not (ContentKind.Contact or ContentKind.Project)){<header class="mx-auto max-w-[1500px] px-5 py-16 md:px-10"><p class="text-xs uppercase tracking-widest text-signal">@brand.SiteName</p><h1 class="mt-5 max-w-4xl font-editorial text-5xl md:text-7xl">@Model.Page.Title</h1><p class="mt-6 max-w-2xl text-muted">@Model.Page.Summary</p><div class="cms-body mt-6 max-w-3xl leading-8">@Html.Raw(ContentMarkup.Render(Model.Page.Body))</div>@foreach(var image in Model.Page.Images){<figure class="mt-8"><img src="@image.Url" srcset="@image.SrcSet" sizes="(min-width: 768px) 70vw, 100vw" alt="@image.Alt" width="@image.Width" height="@image.Height" loading="lazy" class="max-h-[650px] w-full object-contain">@if(image.Caption is not null){<figcaption class="mt-3 text-sm text-muted">@image.Caption</figcaption>}</figure>}</header>}
@if(firstHero is not null && Model.Page.Kind==ContentKind.Page && !string.IsNullOrWhiteSpace(Model.Page.Body)){<div class="cms-body mx-auto max-w-[1500px] px-5 pt-10 leading-8 md:px-10">@Html.Raw(ContentMarkup.Render(Model.Page.Body))</div>}
@foreach(var block in Model.Sections){if(Model.Page.Kind==ContentKind.Page && Model.Page.Key=="home" && block.SectionKind is SectionKind.Projects or SectionKind.Services){<partial name="~/Views/Shared/_HomeDirectoryIndicator.cshtml" model="block" />continue;}if(block.SectionKind==SectionKind.Contact && Model.Contact is not null){<partial name="_ContactSection" model="Model.Contact" />continue;}var anchor=block.SectionKind==SectionKind.Services?"expertise":block.Key;var dark=block.Background=="evergreen";
<section id="@anchor" class="scroll-mt-32 px-5 py-16 md:px-10 lg:py-24 @(dark?"bg-evergreen text-ivory":block.Background=="panel"?"bg-panel":"bg-paper")" data-layout="@block.Layout"><div class="mx-auto max-w-[1500px]">
<div data-reveal class="grid gap-8 @(block.Layout=="wide"?"":"md:grid-cols-[1.3fr_1fr]")"><div><p class="text-xs uppercase tracking-widest @(dark?"text-gold":"text-signal")">@(block.Layout=="numbered"?$"{Model.Sections.ToList().IndexOf(block)+1:00} / ":"")@L["CmsSection"+block.SectionKind]</p>
@if(firstHero?.Id==block.Id){<h1 data-parallax="@Math.Round(block.Parallax*12)" class="mt-5 max-w-4xl font-editorial text-[clamp(3rem,6vw,6rem)] leading-tight">@block.Title</h1>}else{<h2 class="mt-5 max-w-3xl font-editorial text-[clamp(2.5rem,4.5vw,4.5rem)] leading-tight">@block.Title</h2>}</div><div class="max-w-2xl self-end text-sm leading-7 @(dark?"text-ivory/80":"text-muted")"><p>@block.Summary</p><div class="cms-body">@Html.Raw(ContentMarkup.Render(block.Body))</div></div></div>
@if(block.Images.Count>0){<div class="mt-8 grid gap-5 md:grid-cols-2">@foreach(var image in block.Images){<figure data-parallax="@Math.Round(block.Parallax*20)"><img src="@image.Url" srcset="@image.SrcSet" sizes="(min-width: 768px) 70vw, 100vw" alt="@image.Alt" width="@image.Width" height="@image.Height" loading="lazy" class="w-full object-cover">@if(image.Caption is not null){<figcaption class="mt-3 text-sm">@image.Caption</figcaption>}</figure>}</div>}
<div class="mt-6 flex flex-wrap gap-5">@if(!string.IsNullOrWhiteSpace(block.PrimaryLabel)&&!string.IsNullOrWhiteSpace(block.PrimaryTarget)){<a href="@block.PrimaryTarget.Replace("{culture}",culture)" class="inline-flex min-h-12 items-center bg-accent px-5 text-on-accent">@block.PrimaryLabel</a>}@if(!string.IsNullOrWhiteSpace(block.SecondaryLabel)&&!string.IsNullOrWhiteSpace(block.SecondaryTarget)){<a href="@block.SecondaryTarget.Replace("{culture}",culture)" class="inline-flex min-h-12 items-center border-b border-current">@block.SecondaryLabel</a>}</div>
@if(block.SectionKind==SectionKind.Hero && block.Images.Count==0){<svg aria-hidden="true" data-parallax="@Math.Round(block.Parallax*24)" viewBox="0 0 1000 180" fill="none" class="mt-10 w-full text-signal"><path d="M0 90H100 M300 90H400 M600 90H700 M900 90H1000 M200 140V170H800V140" stroke="currentColor" stroke-width="2"/><rect x="100" y="40" width="200" height="100" stroke="currentColor"/><rect x="400" y="40" width="200" height="100" stroke="currentColor"/><rect x="700" y="40" width="200" height="100" stroke="currentColor"/><path d="M150 90H250 M200 65V115 M450 65H550V115H450Z M750 75H850 M750 105H850" stroke="currentColor" stroke-width="2"/></svg>}
@if(block.SectionKind==SectionKind.Projects){<partial name="_CmsProjects" model="Model.Projects" />}
@if(block.SectionKind==SectionKind.Services){<partial name="_CmsServices" model="Model.Services" />}
@if(block.SectionKind==SectionKind.Contact && Model.Contact is not null){<partial name="_CmsContact" model="Model.Contact" />}
</div></section>}
@if(Model.IsPreview&&Model.Page.Kind==ContentKind.Navigation){<nav class="mx-auto flex max-w-[1500px] flex-wrap gap-5 px-5 pb-10" aria-label="@L["Navigation"]">@foreach(var link in Model.Page.Links){<a href="@link.Href" class="inline-flex min-h-11 items-center underline @(link.Depth>0?"ps-5":"")">@link.Label</a>}</nav>}
@if(Model.IsPreview&&Model.Page.Kind==ContentKind.Contact){<partial name="_ContactSection" model="Model.Page" />}
@if(Model.IsPreview&&Model.Page.Kind==ContentKind.Service){<section class="mx-auto max-w-[1500px] px-5 pb-10"><partial name="_CmsServices" model="new List<PublicNode>{Model.Page}" /></section>}
</main>
@if(Model.Footer is not null || brand.Social.Count>0){<footer class="bg-evergreen px-5 py-14 text-ivory md:px-10"><div class="mx-auto grid max-w-[1500px] gap-8 md:grid-cols-2"><div><h2 class="font-editorial text-4xl">@(Model.Footer?.Title??brand.SiteName)</h2><p class="mt-5 max-w-xl text-sm leading-7 text-ivory/80">@(Model.Footer?.Summary??"")</p><div class="cms-body text-sm leading-7">@Html.Raw(ContentMarkup.Render(Model.Footer?.Body))</div></div><nav aria-label="@L["FooterNavigation"]" class="flex flex-wrap items-start gap-5">@if(Model.FooterNavigation is not null){foreach(var link in Model.FooterNavigation.Links){<a href="@link.Href" class="inline-flex min-h-11 items-center">@link.Label</a>}}@foreach(var social in (Model.Footer?.Social??new List<PublicLink>()).Concat(brand.Social).DistinctBy(x=>x.Label)){<a href="@social.Href" rel="noopener noreferrer" class="inline-flex min-h-11 items-center underline">@L["Social"+social.Label]</a>}</nav>@if((Model.Footer?.ShowCopyright??true)){<p class="text-xs" dir="ltr">© @DateTime.UtcNow.Year @brand.SiteName</p>}</div></footer>}
@if(Model.Page.Kind!=ContentKind.Project){<partial name="_ProjectDialog" model='new HomeViewModel(culture,Array.Empty<NLOIQ.Application.Interfaces.ServicePreviewDto>(),new Dictionary<string,string?>())' />}
</body></html>
