@model HomeViewModel
@inject NLOIQ.Application.Content.IBrandReader BrandReader
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> Localizer

@{ var alternateCulture = Model.IsArabic ? "en" : "ar"; var brand=await BrandReader.ReadAsync(Model.Culture); }
<!doctype html>
<html lang="@Model.Culture" dir="@(Model.IsArabic ? "rtl" : "ltr")" data-default-theme="@brand.DefaultTheme">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow"><meta name="description" content="@Localizer["Intro"]"><title>@Localizer["Title"]</title>
<link rel="alternate" hreflang="en" href="@(brand.BaseUrl is null?"/en/":new Uri(new Uri(brand.BaseUrl),"/en/").AbsoluteUri)">
<link rel="alternate" hreflang="ar" href="@(brand.BaseUrl is null?"/ar/":new Uri(new Uri(brand.BaseUrl),"/ar/").AbsoluteUri)">
<link rel="alternate" hreflang="x-default" href="@(brand.BaseUrl is null?$"/{brand.DefaultCulture}/":new Uri(new Uri(brand.BaseUrl),$"/{brand.DefaultCulture}/").AbsoluteUri)">
<meta property="og:locale" content="@(Model.IsArabic?"ar_IQ":"en_US")"><meta property="og:locale:alternate" content="@(Model.IsArabic?"en_US":"ar_IQ")">
<script src="~/js/theme-init.js" asp-append-version="true"></script>
<link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
<partial name="_BrandHead" model="brand" /><link rel="stylesheet" href="~/css/public.css" asp-append-version="true">
<script src="~/js/app.js" asp-append-version="true" defer></script>
<script src="~/js/motion.mjs" type="module" asp-append-version="true"></script>
</head>
<body class="public-site bg-paper text-ink antialiased">
<a href="#main" class="sr-only focus:not-sr-only focus:block focus:p-4">@Localizer["Skip"]</a>
<partial name="_PublicHeader" model='new NLOIQ.Web.ViewModels.PublicShellModel(Model.Culture,brand,$"/{alternateCulture}/")' />
<main id="main" tabindex="-1"><div class="public-container"><partial name="Sections/_Hero" model="Model" /><partial name="Sections/_Services" model="Model" /><partial name="Sections/_Projects" model="Model" /><partial name="Sections/_About" model="Model" /></div><partial name="Sections/_Contact" model="Model" /></main>
<partial name="_PublicFooter" model='new NLOIQ.Web.ViewModels.PublicShellModel(Model.Culture,brand,$"/{alternateCulture}/")' />
</body></html>
