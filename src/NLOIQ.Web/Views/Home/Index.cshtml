@model HomeViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> Localizer
@{
    var alternateCulture = Model.IsArabic ? "en" : "ar";
    var iconPaths = new Dictionary<string, string> {
        ["low-current"] = "M4 6h24M8 6v10m8-10v10m8-10v10M4 16h8v8H4zm8 0h8v8h-8zm8 0h8v8h-8z",
        ["software"] = "m11 8-7 8 7 8m10-16 7 8-7 8M19 5l-6 22",
        ["scada"] = "M3 4h26v20H3zM8 29h16M16 24v5M7 19l5-7 5 3 8-8",
        ["automation"] = "M3 8h7v7H3zM22 19h7v7h-7zM10 11h9v12h3M19 11h10M3 23h10"
    };
}
<!doctype html>
<html lang="@Model.Culture" dir="@(Model.IsArabic ? "rtl" : "ltr")">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow"><title>@Localizer["Title"]</title>
<script src="~/js/theme-init.js" asp-append-version="true"></script>
<link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
<script src="~/js/app.js" asp-append-version="true" defer></script>
</head>
<body class="bg-paper text-ink antialiased">
<a href="#main" class="sr-only focus:not-sr-only focus:block focus:p-4">@Localizer["Skip"]</a>
<div class="border-b border-line bg-panel px-5 py-3 text-sm text-muted md:px-10"><div class="mx-auto max-w-[1500px]">@Localizer["Demo"]</div></div>
<header class="mx-auto flex max-w-[1500px] flex-wrap items-center justify-between gap-6 border-b border-line px-5 py-6 md:px-10">
<div class="flex items-center gap-3"><span class="border border-ink px-3 py-2 text-xl font-bold tracking-tight" dir="ltr">NLO IQ</span><span class="max-w-20 text-[10px] uppercase tracking-widest text-muted">@Localizer["Logo"]</span></div>
<nav class="flex flex-wrap items-center gap-5 text-sm" aria-label="@(Model.IsArabic ? "التنقّل" : "Navigation")"><a href="#expertise" class="inline-flex min-h-11 items-center">@Localizer["Services"]</a><a href="/@alternateCulture/" class="inline-flex min-h-11 items-center border-b border-line" lang="@alternateCulture">@(Model.IsArabic ? "English" : "العربية")</a><label class="flex items-center gap-2"><span>@Localizer["Theme"]</span><select id="theme" class="min-h-11 border border-line bg-paper px-2"><option value="system">@Localizer["System"]</option><option value="light">@Localizer["Light"]</option><option value="dark">@Localizer["Dark"]</option></select></label></nav>
</header>
<main id="main" class="mx-auto max-w-[1500px] px-5 md:px-10">
<section class="grid items-center gap-5 overflow-hidden border-b border-line py-10 lg:grid-cols-[1.12fr_1fr] lg:py-16" aria-labelledby="hero-title"><div><p class="mb-5 text-xs uppercase tracking-[.18em] text-signal">@Localizer["Phase"]</p><p class="mb-8 text-xs uppercase tracking-[.2em] text-muted">@Localizer["Eyebrow"]</p>
<h1 id="hero-title" class="font-editorial text-[clamp(3rem,6.4vw,6.8rem)] leading-[1.02] tracking-[-.055em]">@Localizer["Heading1"]<br>@Localizer["Heading2"]<br><em class="text-accent">@Localizer["Heading3"]</em><br>@Localizer["Heading4"]</h1>
<p class="mt-8 max-w-md text-base leading-7 text-muted">@Localizer["Intro"]</p><a href="#expertise" class="mt-9 inline-flex min-h-12 items-center bg-accent px-6 py-3 text-sm text-on-accent">@Localizer["Explore"] <span aria-hidden="true" class="ms-4">@(Model.IsArabic ? "↖" : "↗")</span></a></div><partial name="_SystemStudy" /></section>
<section id="expertise" class="grid gap-10 py-14 md:grid-cols-[1fr_1.6fr]" aria-labelledby="expertise-title"><div><p class="text-xs uppercase tracking-widest text-muted">@Localizer["ServiceLabel"]</p><h2 id="expertise-title" class="mt-5 font-editorial text-4xl">@Localizer["ServiceHeading"]</h2><p class="mt-5 max-w-md leading-7 text-muted">@Localizer["SeedNote"]</p><p class="mt-6 text-xs text-signal" dir="ltr">@Localizer["Foundation"]</p></div><div class="border-t border-line">
@if (Model.Services.Count == 0) { <p class="py-8 leading-7">@Localizer["Empty"]</p> }
@foreach (var service in Model.Services) {
<details class="border-b border-line py-5"><summary class="flex min-h-11 cursor-pointer items-center gap-4"><svg viewBox="0 0 32 32" class="h-8 w-8 shrink-0 text-signal" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="@(iconPaths.GetValueOrDefault(service.Key, "M4 16h24"))"/></svg><span class="text-xs text-muted">@service.DisplayOrder.ToString("00")</span><span class="text-lg">@service.Title</span><span class="ms-auto text-accent" aria-hidden="true">+</span></summary><p class="mt-4 text-xs uppercase tracking-widest text-signal">@Localizer["DemoTag"]</p><p class="mt-3 max-w-lg leading-7 text-muted">@service.Summary</p></details>
}
</div></section>
</main><footer class="border-t border-line px-5 py-6 text-sm text-muted md:px-10"><div class="mx-auto flex max-w-[1500px] flex-wrap justify-between gap-4"><p>@Localizer["Footer"]</p><p dir="ltr">© @DateTime.UtcNow.Year NLO IQ</p></div></footer>
</body></html>
