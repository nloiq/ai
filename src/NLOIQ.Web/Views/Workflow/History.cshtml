@model NLOIQ.Application.Content.WorkflowHistory
@using NLOIQ.Domain.Content
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{Layout="_AdminLayout";ViewData["Title"]=L["WorkflowHistory"];var culture=Context.Request.RouteValues["culture"]?.ToString();var zone=TimeZoneInfo.FindSystemTimeZoneById("Asia/Baghdad");string Baghdad(DateTime utc)=>TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc,DateTimeKind.Utc),zone).ToString("yyyy-MM-dd HH:mm",System.Globalization.CultureInfo.InvariantCulture);}
<a href="/@culture/admin/content/@Model.Id" class="inline-flex min-h-11 items-center underline">@L["CmsEdit"]</a><h1 class="my-5 text-3xl">@L["WorkflowHistory"]</h1><p class="text-sm text-muted">@L["CmsKind"+Model.Kind] / <bdi dir="ltr">@Model.Key</bdi> · @L["Cms"+Model.State]</p>
@if(TempData["CmsNotice"] is string notice){<p role="status" class="my-5 border border-line bg-panel p-4 text-signal">@notice</p>}@if(TempData["CmsError"] is string error){<p role="alert" class="my-5 border border-accent p-4">@error</p>}
<p class="mt-5 max-w-3xl text-sm leading-7 text-muted">@L["WorkflowHistoryHelp"]</p>
@if(User.IsInRole("SuperAdmin")&&Model.DraftRevisionId is long draft&&Model.State!=PublicationState.Archived){<section class="cms-panel my-7"><h2 class="text-xl">@L["WorkflowSchedule"]</h2><p class="my-4 max-w-3xl text-sm leading-7 text-muted">@L["WorkflowScheduleHelp"]</p><form method="post" action="/@culture/admin/content/@Model.Id/schedule" asp-antiforgery="true" class="space-y-4"><input type="hidden" name="version" value="@Model.Version"><input type="hidden" name="revisionId" value="@draft"><label class="cms-field max-w-sm">@L["WorkflowBaghdad"]<input type="datetime-local" name="scheduledLocal" required dir="ltr" class="cms-input"></label><label class="flex items-start gap-3 text-sm leading-7"><input type="checkbox" name="verified" value="true" required class="mt-2">@L["CmsVerify"]</label><button class="min-h-11 bg-accent px-4 text-on-accent">@L["WorkflowSchedule"]</button></form></section>}
@if(Model.Schedules.Count>0){<section class="my-7"><h2 class="mb-4 text-xl">@L["WorkflowSchedules"]</h2><div class="grid gap-4 xl:grid-cols-2">@foreach(var job in Model.Schedules){<article data-schedule="@job.Id" class="min-w-0 border border-line bg-panel p-5"><p class="text-sm">@L["WorkflowState"+job.State] · @L["CmsRevision"] #@job.RevisionNumber</p><p class="mt-3 text-sm"><bdi dir="ltr">@Baghdad(job.ScheduledUtc)</bdi> · @L["WorkflowBaghdadShort"]</p><p class="mt-3 break-words text-xs text-muted"><bdi>@job.Actor</bdi></p>@if(job.FailureCode is not null){<p class="mt-3 text-sm">@(L["WorkflowReason"+job.FailureCode].ResourceNotFound?L["WorkflowReasonValidationFailed"]:L["WorkflowReason"+job.FailureCode])</p>}@if(job.State==ScheduleState.Pending&&User.IsInRole("SuperAdmin")){<form method="post" action="/@culture/admin/content/@Model.Id/schedules/@job.Id/cancel" asp-antiforgery="true" class="mt-4"><input type="hidden" name="version" value="@Model.Version"><input type="hidden" name="scheduleVersion" value="@job.Version"><button class="cms-small">@L["WorkflowCancel"]</button></form>}</article>}</div></section>}
<div class="mt-7 space-y-4">@foreach(var revision in Model.Revisions){<article data-revision="@revision.Id" class="min-w-0 border border-line bg-panel p-5"><div class="flex flex-wrap justify-between gap-3"><h2 class="text-lg">@L["CmsRevision"] @revision.Number @if(revision.IsDraft){<span class="text-xs text-signal"> · @L["WorkflowCurrentDraft"]</span>}@if(revision.IsPublished){<span class="text-xs text-signal"> · @L["CmsPublished"]</span>}</h2><time datetime="@revision.CreatedUtc.ToString("O")" class="text-xs" dir="ltr">@Baghdad(revision.CreatedUtc)</time></div><h3 class="my-4 break-words text-lg">@(culture=="ar"?revision.TitleAr:revision.TitleEn)</h3><p class="break-words text-xs text-muted"><bdi>@(string.IsNullOrWhiteSpace(revision.Actor)?L["WorkflowSystem"].Value:revision.Actor)</bdi> · @L["WorkflowBaghdadShort"]</p>@if(!string.IsNullOrWhiteSpace(revision.ChangeNote)){<p class="mt-3 break-words text-sm"><bdi>@revision.ChangeNote</bdi></p>}<a href="/@culture/admin/content/@Model.Id/revisions/@revision.Id/preview" class="mt-4 inline-flex min-h-11 items-center text-sm underline">@L["WorkflowPreview"]</a><form method="post" action="/@culture/admin/content/@Model.Id/restore" asp-antiforgery="true" class="mt-4 flex flex-wrap items-center gap-4"><input type="hidden" name="version" value="@Model.Version"><input type="hidden" name="revisionId" value="@revision.Id"><label class="flex items-start gap-3 text-xs leading-6"><input type="checkbox" name="confirm" value="true" required class="mt-1">@L["WorkflowRestoreConfirm"]</label><button class="cms-small">@L["WorkflowRestore"]</button></form></article>}</div>
<nav class="mt-6 flex gap-4">@if(Model.Page>1){<a href="?page=@(Model.Page-1)" class="cms-small">@L["MediaPrevious"]</a>}@if(Model.HasNext){<a href="?page=@(Model.Page+1)" class="cms-small">@L["MediaNext"]</a>}</nav>
