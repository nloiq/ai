@model NLOIQ.Web.ViewModels.PublicShellModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
<footer class="public-footer"><div class="public-container"><div class="public-footer-top"><div><a class="public-footer-brand" href="/@Model.Culture/">@Model.Brand.SiteName<span class="brand-dot">.</span></a><p>@(Model.Footer?.Summary??L["StudioPositioning"].Value)</p>@if(!string.IsNullOrWhiteSpace(Model.Footer?.Body)){<div class="cms-body">@Html.Raw(NLOIQ.Application.Content.ContentMarkup.Render(Model.Footer.Body))</div>}</div><nav aria-label="@L["FooterNavigation"]">@if(Model.FooterNavigation?.Links.Count>0){foreach(var link in Model.FooterNavigation.Links){<a href="@link.Href">@link.Label</a>}}else{<a href="/@Model.Culture/projects">@L["DirectoryProjects"]</a><a href="/@Model.Culture/services">@L["DirectoryServices"]</a><a href="/@Model.Culture/contact">@L["InquiryContactUs"]</a>}@foreach(var link in (Model.Footer?.Social??new()).Concat(Model.Brand.Social).DistinctBy(x=>x.Label)){<a href="@link.Href" rel="noopener noreferrer">@L["Social"+link.Label]</a>}</nav></div><div class="public-footer-bottom">@if(Model.Footer?.ShowCopyright!=false){<span dir="ltr">© @DateTime.UtcNow.Year @Model.Brand.SiteName</span>}<span>@L["StudioDisciplines"]</span></div></div></footer>
