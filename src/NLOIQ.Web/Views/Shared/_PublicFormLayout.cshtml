@inject NLOIQ.Application.Content.IBrandReader BrandReader
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{var culture=Context.Request.RouteValues["culture"]?.ToString()=="ar"?"ar":"en";var brand=await BrandReader.ReadAsync(culture);}
<!doctype html><html lang="@culture" dir="@(culture=="ar"?"rtl":"ltr")" data-default-theme="@brand.DefaultTheme"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>@ViewData["Title"] · @brand.SiteName</title><script src="~/js/theme-init.js" asp-append-version="true"></script><link rel="stylesheet" href="~/css/app.css" asp-append-version="true"><partial name="_BrandHead" model="brand" /><script src="~/js/admin.js" asp-append-version="true" defer></script></head><body class="min-h-screen bg-paper text-ink antialiased"><a href="#main" class="sr-only focus:not-sr-only focus:block focus:p-4">@L["Skip"]</a><header class="border-b border-line px-5 py-4 md:px-10"><div class="mx-auto flex max-w-[1500px] flex-wrap items-center justify-between gap-4"><a href="/@culture/" aria-label="@brand.SiteName"><partial name="_LogoMark" model="brand" /></a><partial name="_ThemeSelector" model="brand" /></div></header><main id="main" tabindex="-1" class="mx-auto max-w-3xl px-5 py-12 md:py-20">@RenderBody()</main></body></html>
