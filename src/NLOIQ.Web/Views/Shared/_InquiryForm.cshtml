@model NLOIQ.Web.ViewModels.ContactInquiryModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{var culture=Context.Request.RouteValues["culture"]?.ToString()=="ar"?"ar":"en";var preview=ViewData["ContactPreview"] is true;}
<form method="post" action="/@culture/contact" asp-antiforgery="true" class="inquiry-form" id="inquiry-form">
<input asp-for="SubmissionId" type="hidden">
<div hidden aria-hidden="true"><label for="inquiry-website">Website</label><input asp-for="Website" id="inquiry-website" tabindex="-1" autocomplete="off" maxlength="200"></div>
<div asp-validation-summary="All" class="mb-5 text-sm" role="alert"></div>
@if(preview){<p class="mb-5 text-sm">@L["InquiryPreview"]</p>}
<fieldset disabled="@preview"><legend class="sr-only">@L["InquiryTitle"]</legend><div class="grid gap-5 sm:grid-cols-2">
<label class="cms-field" for="inquiry-name">@L["InquiryName"] <span aria-hidden="true">*</span><input asp-for="Name" id="inquiry-name" required minlength="2" maxlength="120" autocomplete="name" class="cms-input"></label>
<label class="cms-field" for="inquiry-email">@L["InquiryEmail"] <span aria-hidden="true">*</span><input asp-for="Email" id="inquiry-email" type="email" required maxlength="254" autocomplete="email" dir="ltr" class="cms-input"></label>
<label class="cms-field" for="inquiry-company">@L["InquiryCompany"]<input asp-for="Company" id="inquiry-company" maxlength="160" autocomplete="organization" class="cms-input"></label>
<label class="cms-field" for="inquiry-phone">@L["InquiryPhone"]<input asp-for="Phone" id="inquiry-phone" type="tel" maxlength="40" autocomplete="tel" dir="ltr" class="cms-input"></label>
</div><label class="cms-field mt-5" for="inquiry-service">@L["InquiryService"]<select asp-for="Service" id="inquiry-service" class="cms-input"><option value="general">@L["InquiryGeneral"]</option><option value="low-current">@L["InquiryLowCurrent"]</option><option value="software">@L["InquirySoftware"]</option><option value="scada">@L["InquiryScada"]</option><option value="automation">@L["InquiryAutomation"]</option></select></label>
<label class="cms-field mt-5" for="inquiry-message">@L["InquiryMessage"] <span aria-hidden="true">*</span><textarea asp-for="Message" id="inquiry-message" required minlength="10" maxlength="4000" rows="6" aria-describedby="inquiry-note" class="cms-input"></textarea></label>
<p id="inquiry-note" class="mt-3 text-xs leading-6">@L["InquiryNote"]</p><label class="mt-5 flex items-start gap-3 text-sm leading-7" for="inquiry-consent"><input asp-for="Consent" id="inquiry-consent" required class="mt-2">@L["InquiryConsent"]</label>
<button type="submit" class="inquiry-submit mt-6 inline-flex min-h-12 items-center justify-center gap-4 px-6 font-semibold">@L["InquirySend"]<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 19 19 5M5 5h14v14"/></svg></button>
</fieldset></form>
