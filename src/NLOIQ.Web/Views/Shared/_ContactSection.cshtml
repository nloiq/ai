@model NLOIQ.Application.Content.PublicNode
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
<section id="contact" data-contact-revision="@Model.RevisionId" class="scroll-mt-32 bg-evergreen px-5 pb-8 pt-16 text-ivory md:px-10 lg:pt-24" aria-labelledby="contact-title"><div class="mx-auto max-w-[1500px]">
@if(!string.IsNullOrWhiteSpace(Model.PrimaryLabel)){<p class="text-xs uppercase tracking-widest text-gold">@Model.PrimaryLabel</p>}
<div class="mt-7 grid gap-10 border-b border-ivory/30 pb-14 lg:grid-cols-[1.4fr_1fr]"><h2 id="contact-title" class="font-editorial text-[clamp(3rem,6vw,6rem)] leading-[1.08] tracking-[-.035em] break-words">@Model.Title@if(!string.IsNullOrWhiteSpace(Model.SecondaryLabel)){<br><em class="text-gold">@Model.SecondaryLabel</em>}</h2><div class="min-w-0 self-end"><p class="max-w-lg text-lg leading-8 text-ivory/90">@Model.Summary</p><div class="cms-body mt-5 max-w-lg text-sm leading-7 text-ivory/80">@Html.Raw(NLOIQ.Application.Content.ContentMarkup.Render(Model.Body))</div></div></div>
@if(Model.Contacts.Count>0||Model.Hours.Count>0){<dl class="grid gap-8 border-b border-ivory/30 py-8 sm:grid-cols-2 lg:grid-cols-4">@foreach(var detail in Model.Contacts){<div class="min-w-0"><dt class="text-xs uppercase tracking-widest text-gold">@detail.Label</dt><dd class="mt-3 break-words text-sm leading-7 text-ivory/90">@if(detail.Href is not null){<a href="@detail.Href" class="inline-flex min-h-9 max-w-full items-center break-all underline underline-offset-4">@detail.Value</a>}else{@detail.Value}</dd></div>}
@if(Model.Hours.Count>0){<div class="min-w-0"><dt class="text-xs uppercase tracking-widest text-gold">@L["CmsHours"]</dt><dd class="mt-3 space-y-2 text-sm leading-7 text-ivory/90">@foreach(var hours in Model.Hours){<div class="flex flex-wrap justify-between gap-x-3"><span>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName((DayOfWeek)hours.Day)</span><span>@(hours.Closed?L["CmsClosed"].Value:$"{hours.Opens:HH:mm} – {hours.Closes:HH:mm}")</span></div>}</dd></div>}</dl>}
@if(Model.Social.Count>0){<nav aria-label="@L["CmsSocial"]" class="flex flex-wrap gap-x-6 gap-y-2 py-5">@foreach(var social in Model.Social){<a href="@social.Href" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-sm text-gold underline underline-offset-4">@L["Social"+social.Label]</a>}</nav>}
</div></section>
