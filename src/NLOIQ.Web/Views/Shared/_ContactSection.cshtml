@model NLOIQ.Application.Content.PublicNode
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
<section id="contact" data-contact-revision="@Model.RevisionId" class="scroll-mt-32 bg-evergreen px-5 py-16 text-ivory md:px-10 lg:py-24" aria-labelledby="contact-title"><div class="mx-auto max-w-[1500px]">
<div class="max-w-3xl">@if(!string.IsNullOrWhiteSpace(Model.PrimaryLabel)){<p class="text-xs uppercase tracking-widest text-gold">@Model.PrimaryLabel</p>}<h2 id="contact-title" class="mt-4 font-editorial text-[clamp(2.5rem,5vw,4.5rem)] leading-tight break-words">@Model.Title@if(!string.IsNullOrWhiteSpace(Model.SecondaryLabel)){<br><em class="text-gold">@Model.SecondaryLabel</em>}</h2><p class="mt-5 max-w-2xl leading-8 text-ivory/90">@Model.Summary</p><div class="cms-body mt-3 max-w-2xl text-sm leading-7 text-ivory/80">@Html.Raw(NLOIQ.Application.Content.ContentMarkup.Render(Model.Body))</div></div>
<div class="mt-10 grid items-start gap-7 lg:grid-cols-[1.3fr_1fr]"><div class="inquiry-card min-w-0 rounded-2xl p-5 md:p-8"><p class="text-xs uppercase tracking-widest">@L["InquiryContactUs"]</p><h3 class="mt-3 text-2xl font-semibold">@L["InquiryTitle"]</h3><p class="mb-6 mt-3 max-w-lg text-sm leading-7">@L["InquiryIntro"]</p><partial name="_InquiryForm" model="new NLOIQ.Web.ViewModels.ContactInquiryModel()" /></div>
<aside class="min-w-0 space-y-6" aria-label="@L["InquiryContactDetails"]">
<div class="contact-info-card rounded-2xl p-6 md:p-8"><div class="flex items-center gap-3"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/></svg><h3 class="text-xl font-semibold">@L["InquiryHours"]</h3></div><p class="mt-3 text-xs leading-6 text-ivory/80">@L["InquiryTimezone"]</p>
<dl class="mt-5">@foreach(var day in new[]{0,1,2,3,4,5,6}){var hours=Model.Hours.SingleOrDefault(x=>x.Day==day);<div class="flex flex-wrap justify-between gap-x-4 gap-y-1 border-b border-ivory/20 py-3 text-sm"><dt>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName((DayOfWeek)day)</dt><dd dir="@(hours is not null&&!hours.Closed?"ltr":null)" class="@(hours is null?"text-ivory/70":"text-gold")">@(hours is null?L["InquiryHoursMissing"].Value:hours.Closed?L["CmsClosed"].Value:$"{hours.Opens:HH:mm} – {hours.Closes:HH:mm}")</dd></div>}</dl></div>
@if(Model.Contacts.Count>0||Model.Social.Count>0){<div class="contact-info-card rounded-2xl p-6 md:p-8"><h3 class="text-xl font-semibold">@L["InquiryContactDetails"]</h3><dl class="mt-5 space-y-5">@foreach(var detail in Model.Contacts){<div class="min-w-0"><dt class="text-xs uppercase tracking-widest text-gold">@detail.Label</dt><dd class="mt-1 break-words text-sm leading-7">@if(detail.Href is not null){<a href="@detail.Href" class="inline-flex min-h-9 max-w-full items-center break-all underline underline-offset-4">@detail.Value</a>}else{@detail.Value}</dd></div>}</dl>@if(Model.Social.Count>0){<nav aria-label="@L["CmsSocial"]" class="mt-5 flex flex-wrap gap-x-5 gap-y-2 border-t border-ivory/20 pt-4">@foreach(var social in Model.Social){<a href="@social.Href" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-sm text-gold underline underline-offset-4">@L["Social"+social.Label]</a>}</nav>}</div>}
</aside></div></div></section>
