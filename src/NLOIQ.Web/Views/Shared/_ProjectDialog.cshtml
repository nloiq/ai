@model HomeViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> Localizer
<dialog id="project-dialog" aria-labelledby="dialog-title" aria-describedby="dialog-description" class="m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-5xl overflow-hidden border border-line bg-paper p-0 text-ink shadow-2xl backdrop:bg-evergreen/85" data-video-title="@Localizer["VideoTitle"]" data-video-note="@Localizer["SuppliedVideoNote"]" data-no-video-note="@Localizer["NoVideo"]">
<div class="flex max-h-[calc(90dvh-2px)] flex-col">
<div class="flex shrink-0 items-start justify-between gap-4 px-5 py-5 md:px-8 md:py-6"><div><p class="text-xs uppercase tracking-widest text-signal">@Localizer["Illustration"]</p><h2 id="dialog-title" class="mt-3 font-editorial text-3xl md:text-4xl"></h2></div><button type="button" id="dialog-close" autofocus class="inline-flex min-h-11 min-w-11 items-center justify-center border border-line px-3 text-sm">@Localizer["Close"] <span aria-hidden="true" class="ms-2">×</span></button></div>
<div id="dialog-content" class="min-h-0 overflow-y-auto px-5 pb-6 md:px-8"><div id="dialog-media" class="aspect-video w-full overflow-hidden bg-evergreen"></div><p id="dialog-video-note" class="mt-4 text-sm leading-7 text-signal"></p><p id="dialog-description" class="mt-3 max-w-3xl text-base leading-7 text-muted"></p></div>
<div class="flex shrink-0 flex-wrap items-center justify-between gap-4 border-t border-line px-5 py-4 md:px-8"><button type="button" id="dialog-previous" class="min-h-11 border border-line px-4 text-sm"><span aria-hidden="true">@(Model.IsArabic ? "→" : "←")</span> @Localizer["Previous"]</button><p id="dialog-position" aria-live="polite" aria-atomic="true" class="text-xs text-muted"></p><button type="button" id="dialog-next" class="min-h-11 border border-line px-4 text-sm">@Localizer["Next"] <span aria-hidden="true">@(Model.IsArabic ? "←" : "→")</span></button></div>
</div></dialog>
