@model NLOIQ.Application.Content.PublicSite
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{var project=Model.Page;var cover=project.Images.FirstOrDefault();var culture=Model.Culture;}
<article class="mx-auto max-w-[1500px] px-5 pb-16 pt-8 md:px-10 lg:pb-24">
<a href="/@culture/#projects" class="inline-flex min-h-11 items-center gap-3 text-sm text-muted underline underline-offset-4"><span aria-hidden="true">@(culture=="ar"?"→":"←")</span>@L["ProjectBack"]</a>
<header class="grid gap-6 border-b border-line pb-9 pt-6 lg:grid-cols-[1fr_auto] lg:items-end"><div class="min-w-0"><p class="text-xs uppercase tracking-widest text-signal">@L["ProjectPortfolio"]</p><h1 class="mt-4 max-w-5xl break-words font-editorial text-[clamp(2.5rem,5.4vw,5.5rem)] leading-tight">@project.Title</h1>@if(!string.IsNullOrWhiteSpace(project.Summary)){<p class="mt-5 max-w-3xl text-lg leading-8 text-muted">@project.Summary</p>}</div>@if(project.Categories.Count>0){<div class="flex max-w-sm flex-wrap gap-2">@foreach(var category in project.Categories){<span class="rounded-full border border-line bg-panel px-3 py-2 text-xs">@category</span>}</div>}</header>
<div class="mt-9 grid items-start gap-9 lg:grid-cols-[minmax(0,1fr)_300px]">
<div class="min-w-0">
@if(cover is not null){<section data-project-gallery aria-label="@L["ProjectGallery"]"><div id="project-gallery-stage" class="project-media-stage rounded-2xl border border-line"><a data-gallery-open href="@cover.Url" aria-label="@L["ProjectEnlarge"]" class="project-media-open"><img data-gallery-main src="@cover.Url" srcset="@cover.SrcSet" sizes="(min-width:1024px) 70vw,100vw" alt="@cover.Alt" width="@cover.Width" height="@cover.Height" fetchpriority="high"><span class="project-enlarge-label text-xs"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg>@L["ProjectEnlarge"]</span></a></div>
<div class="mt-4 flex flex-wrap items-start justify-between gap-4"><p data-gallery-caption class="min-w-0 max-w-xl break-words text-sm leading-7 text-muted" hidden="@(string.IsNullOrWhiteSpace(cover.Caption))">@cover.Caption</p><p data-gallery-position dir="ltr" aria-live="polite" aria-atomic="true" class="ms-auto text-xs text-muted">1 / @project.Images.Count</p></div>
<div class="project-thumbnails mt-3" role="group" aria-label="@L["ProjectGallery"]">@for(var index=0;index<project.Images.Count;index++){var image=project.Images[index];<a href="@image.Url" data-gallery-item data-url="@image.Url" data-srcset="@image.SrcSet" data-alt="@image.Alt" data-caption="@image.Caption" data-width="@image.Width" data-height="@image.Height" aria-label="@L["ProjectImage"] @(index+1): @image.Alt" class="project-thumbnail"><img src="@image.Url.Replace("/full","/thumb")" alt="" width="96" height="72" loading="lazy"></a>}</div><p class="mt-3 text-xs leading-6 text-muted">@L["ProjectImageHint"]</p>
<dialog id="project-image-dialog" aria-labelledby="project-image-title" class="project-image-dialog"><div class="flex items-center justify-between gap-5 border-b border-line px-5 py-4"><h2 id="project-image-title" class="min-w-0 break-words text-lg font-semibold">@L["ProjectGallery"]</h2><button data-gallery-close type="button" autofocus class="cms-small" aria-label="@L["Close"]">@L["Close"] <span aria-hidden="true">×</span></button></div><div class="project-dialog-stage"><img data-gallery-dialog-image alt=""></div><p data-gallery-dialog-caption class="px-5 py-3 text-sm leading-7 text-muted"></p><div class="flex flex-wrap items-center justify-between gap-3 border-t border-line px-5 py-4"><button data-gallery-previous type="button" class="cms-small">@L["Previous"]</button><p data-gallery-dialog-position dir="ltr" aria-live="polite" class="text-xs text-muted"></p><button data-gallery-next type="button" class="cms-small">@L["Next"]</button></div></dialog>
</section>}
@if(!string.IsNullOrWhiteSpace(project.Body)){<section class="mt-9 border-t border-line pt-8" aria-labelledby="project-overview-title"><h2 id="project-overview-title" class="text-2xl font-semibold">@L["ProjectOverview"]</h2><div class="cms-body mt-5 max-w-3xl break-words leading-8">@Html.Raw(NLOIQ.Application.Content.ContentMarkup.Render(project.Body))</div></section>}
@if(project.VideoId is not null){<section class="mt-10" aria-labelledby="project-video-title"><h2 id="project-video-title" class="mb-5 text-2xl font-semibold">@L["ProjectVideo"]</h2><iframe src="@("https://www.youtube-nocookie.com/embed/"+project.VideoId+"?autoplay=0&playsinline=1")" title="@project.Title" loading="lazy" allow="encrypted-media; fullscreen; picture-in-picture" allowfullscreen class="aspect-video w-full rounded-xl border border-line"></iframe></section>}
</div>
<aside class="min-w-0 space-y-5 lg:sticky lg:top-28">@if(project.Categories.Count>0||project.Images.Count>0||project.VideoId is not null){<div class="rounded-xl border border-line bg-panel p-6"><dl class="space-y-5">@if(project.Categories.Count>0){<div><dt class="text-xs uppercase tracking-widest text-muted">@L["ProjectExpertise"]</dt><dd class="mt-2 break-words text-sm leading-7">@string.Join(" / ",project.Categories)</dd></div>}@if(project.Images.Count>0){<div><dt class="text-xs uppercase tracking-widest text-muted">@L["ProjectGallery"]</dt><dd class="mt-2 text-sm">@L["ProjectPhotoCount",project.Images.Count]</dd></div>}@if(project.VideoId is not null){<div><dt class="text-xs uppercase tracking-widest text-muted">@L["ProjectVideo"]</dt><dd class="mt-2"><a href="#project-video-title" class="inline-flex min-h-11 items-center text-sm underline">@L["WatchVideo"]</a></dd></div>}</dl></div>}
<div class="rounded-xl border border-line p-6"><h2 class="text-xl font-semibold">@L["ProjectDiscuss"]</h2><p class="mt-3 text-sm leading-7 text-muted">@L["ProjectDiscussNote"]</p><a href="/@culture/#contact" class="mt-5 inline-flex min-h-11 items-center rounded bg-accent px-4 text-sm text-on-accent">@L["InquiryContactUs"]</a></div>
</aside></div></article>
