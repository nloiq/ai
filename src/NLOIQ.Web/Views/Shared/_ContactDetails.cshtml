@model NLOIQ.Application.Content.PublicNode
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
<aside class="min-w-0 space-y-6" aria-label="@L["InquiryContactDetails"]">
<div class="contact-info-card rounded-2xl p-6 md:p-8"><div class="flex items-center gap-3"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-accent"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/></svg><h3 class="text-xl font-semibold">@L["InquiryHours"]</h3></div><p class="mt-3 text-xs leading-6 text-muted">@L["InquiryTimezone"]</p>
<dl class="mt-5">@foreach(var day in new[]{0,1,2,3,4,5,6}){var hours=Model.Hours.SingleOrDefault(x=>x.Day==day);<div class="flex flex-wrap justify-between gap-x-4 gap-y-1 border-b border-line py-3 text-sm"><dt>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName((DayOfWeek)day)</dt><dd dir="@(hours is not null&&!hours.Closed?"ltr":null)" class="@(hours is null?"text-muted":"text-accent")">@(hours is null?L["InquiryHoursMissing"].Value:hours.Closed?L["CmsClosed"].Value:$"{hours.Opens:HH:mm} – {hours.Closes:HH:mm}")</dd></div>}</dl></div>
@if(Model.Contacts.Count>0||Model.Social.Count>0){<div class="contact-info-card rounded-2xl p-6 md:p-8"><h3 class="text-xl font-semibold">@L["InquiryContactDetails"]</h3><dl class="mt-5 space-y-5">@foreach(var detail in Model.Contacts){<div class="min-w-0"><dt class="text-xs uppercase tracking-widest text-accent">@detail.Label</dt><dd class="mt-1 break-words text-sm leading-7">@if(detail.Href is not null){<a href="@detail.Href" class="inline-flex min-h-9 max-w-full items-center break-all underline underline-offset-4">@detail.Value</a>}else{@detail.Value}</dd></div>}</dl>@if(Model.Social.Count>0){<nav aria-label="@L["CmsSocial"]" class="mt-5 flex flex-wrap gap-x-5 gap-y-2 border-t border-line pt-4">@foreach(var social in Model.Social){<a href="@social.Href" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-sm text-accent underline underline-offset-4">@L["Social"+social.Label]</a>}</nav>}</div>}
</aside>