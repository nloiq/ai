@model NLOIQ.Web.ViewModels.PublicShellModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{var c=Model.Culture;var home=Context.Request.Path.Value?.TrimEnd('/')==$"/{c}";var path=Context.Request.Path.Value??"";}
<header id="site-header" class="public-header"><div class="public-container public-nav"><a href="/@c/" class="public-brand" aria-label="@Model.Brand.SiteName"><partial name="_LogoMark" model="Model.Brand" /><span class="public-brand-name" dir="ltr">@Model.Brand.SiteName<span class="brand-dot">.</span></span></a><div class="public-tools"><a href="@Model.AlternateUrl" lang="@(c=="ar"?"en":"ar")" class="public-language">@(c=="ar"?"EN":"العربية")</a><partial name="_ThemeSelector" model="Model.Brand" /><button id="motion-toggle" class="public-motion-toggle" hidden type="button" aria-pressed="false" data-pause-label="@L["MotionPause"]" data-resume-label="@L["MotionResume"]" data-reduced-label="@L["MotionReduced"]">@L["MotionPause"]</button><button id="menu-toggle" hidden type="button" aria-expanded="false" aria-controls="primary-navigation" class="public-menu">@L["Menu"] <span aria-hidden="true">☰</span></button></div><nav id="primary-navigation" aria-label="@L["Navigation"]" class="public-navigation">
@if(Model.Navigation?.Links.Count>0){foreach(var link in Model.Navigation.Links){<a href="@link.Href" class="@(link.Depth>0?"public-subnav":"")">@link.Label</a>}}else{<a href="@(home?"#about":$"/{c}/#about")">@L["About"]</a><a href="/@c/projects" aria-current="@(path.Contains("/projects")?"page":null)">@L["DirectoryProjects"]</a><a href="/@c/services" aria-current="@(path.Contains("/services")?"page":null)">@L["DirectoryServices"]</a><a href="/@c/contact" class="public-nav-contact" aria-current="@(path.Contains("/contact")?"page":null)">@L["InquiryContactUs"] <span aria-hidden="true">↗</span></a>}
</nav></div><div class="page-scroll-progress" aria-hidden="true"></div></header>
