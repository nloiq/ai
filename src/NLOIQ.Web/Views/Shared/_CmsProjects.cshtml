@model IReadOnlyList<NLOIQ.Application.Content.PublicNode>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{var culture=ViewData["Culture"]?.ToString();}
<div class="mt-10 grid items-start gap-x-10 gap-y-12 md:grid-cols-12">@for(var i=0;i<Model.Count;i++){var project=Model[i];var image=project.Images.FirstOrDefault();var playable=image is not null||project.VideoId is not null;
<article data-project="@(playable?project.Key:null)" data-video-id="@project.VideoId" class="min-w-0 @(i%2==0?"md:col-span-7":"md:col-span-5 md:mt-24")">
@if(image is not null){<figure data-parallax="14"><a href="/@culture/projects/@project.Slug" data-project-open="@(playable?"":null)" class="relative block overflow-hidden"><img data-parallax-layer src="@image.Url" alt="@image.Alt" width="@image.Width" height="@image.Height" loading="lazy" class="aspect-[7/5] w-full scale-[1.04] object-cover">@if(project.VideoId is not null){<span aria-hidden="true" class="absolute inset-0 flex items-center justify-center"><span class="flex h-16 w-16 items-center justify-center bg-evergreen text-2xl text-ivory">▶</span></span>}</a>@if(image.Caption is not null){<figcaption class="mt-3 text-xs text-muted">@image.Caption</figcaption>}</figure>}
@if(project.Featured){<p class="mt-4 text-xs uppercase tracking-widest text-accent">@L["CmsFeatured"]</p>}<p class="mt-4 text-xs uppercase tracking-widest text-signal">@string.Join(" / ",project.Categories)</p><h3 data-project-title class="mt-3 font-editorial text-3xl">@project.Title</h3><p data-project-description class="mt-3 text-sm leading-7 text-muted">@project.Summary</p>
@if(playable){<button type="button" hidden data-project-open aria-haspopup="dialog" aria-controls="project-dialog" class="mt-4 inline-flex min-h-11 items-center border-b border-accent text-sm text-accent">@(project.VideoId is not null?L["WatchVideo"]:L["OpenStudy"])</button>}
<a href="/@culture/projects/@project.Slug" class="ms-4 mt-4 inline-flex min-h-11 items-center text-sm underline underline-offset-4">@L["CmsDetails"]</a></article>}
</div>
