@model NLOIQ.Application.Content.PublicNode
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{var c=Context.Request.RouteValues["culture"]?.ToString()=="ar"?"ar":"en";var projects=Model.SectionKind==NLOIQ.Domain.Content.SectionKind.Projects;var type=projects?"projects":"services";}
@if(Model.Visible){<section id="@(projects?"projects":"expertise")" data-home-directory="@type" class="public-directory-invitation"><div class="public-invitation-heading"><p class="public-kicker">@L[projects?"DirectoryProjects":"DirectoryServices"]</p><h2>@Model.Title</h2></div><div><p class="public-invitation-summary">@Model.Summary</p>@if(!projects){<div class="public-capabilities">@foreach(var key in new[]{"low-current","software","scada","automation"}){<span>@L["ServiceCategory_"+key]</span>}</div>}</div><a class="public-text-link" href="/@c/@type">@L[projects?"DirectoryBrowseProjects":"DirectoryBrowseServices"] <span aria-hidden="true">↗</span></a></section>}
