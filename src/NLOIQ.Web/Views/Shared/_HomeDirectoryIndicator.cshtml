@model NLOIQ.Application.Content.PublicNode
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{var culture=Context.Request.RouteValues["culture"]?.ToString()=="ar"?"ar":"en";var projects=Model.SectionKind==NLOIQ.Domain.Content.SectionKind.Projects;var type=projects?"projects":"services";}
<section id="@(projects?Model.Key:"expertise")" data-home-directory="@type" class="scroll-mt-32 border-t border-line px-5 py-10 md:px-10 lg:py-14"><div class="mx-auto grid max-w-[1500px] items-center gap-6 lg:grid-cols-[1fr_1fr_auto]"><div><p class="text-xs uppercase tracking-widest text-signal">@L[projects?"DirectoryProjects":"DirectoryServices"]</p><h2 class="mt-3 font-editorial text-3xl md:text-4xl">@Model.Title</h2></div><p class="max-w-xl text-sm leading-7 text-muted line-clamp-3">@Model.Summary</p><a href="/@culture/@type" class="inline-flex min-h-12 items-center justify-center rounded border border-accent px-5 text-sm text-accent">@L[projects?"DirectoryBrowseProjects":"DirectoryBrowseServices"]</a></div></section>
