@model NLOIQ.Application.Content.PublicNode
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
<div class="mt-8 grid gap-8 md:grid-cols-2"><div><h3 class="text-xl">@Model.Title</h3><p class="mt-4 text-sm leading-7 opacity-80">@Model.Summary</p><div class="cms-body text-sm leading-7">@Html.Raw(NLOIQ.Application.Content.ContentMarkup.Render(Model.Body))</div><dl class="mt-6 space-y-5">@foreach(var detail in Model.Contacts){<div><dt class="text-xs uppercase tracking-widest opacity-70">@detail.Label</dt><dd class="mt-2 break-words">@if(detail.Href is not null){<a href="@detail.Href" class="underline underline-offset-4">@detail.Value</a>}else{@detail.Value}</dd></div>}</dl></div><div><div class="flex flex-wrap gap-4">@foreach(var social in Model.Social){<a href="@social.Href" rel="noopener noreferrer" class="inline-flex min-h-11 items-center underline underline-offset-4">@social.Label</a>}</div>@if(Model.Hours.Count>0){<h3 class="mt-5 text-sm">@L["CmsHours"]</h3><dl class="mt-3 space-y-3 text-sm">@foreach(var hours in Model.Hours){<div class="flex flex-wrap justify-between gap-3"><dt>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName((DayOfWeek)hours.Day)</dt><dd>@(hours.Closed?L["CmsClosed"].Value:$"{hours.Opens:HH:mm} – {hours.Closes:HH:mm}")</dd></div>}</dl>}</div></div>
