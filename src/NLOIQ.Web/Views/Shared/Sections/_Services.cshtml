@model HomeViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> Localizer
@{ var iconPaths = new Dictionary<string, string> {
        ["low-current"] = "M4 6h24M8 6v10m8-10v10m8-10v10M4 16h8v8H4zm8 0h8v8h-8zm8 0h8v8h-8z",
        ["software"] = "m11 8-7 8 7 8m10-16 7 8-7 8M19 5l-6 22",
        ["scada"] = "M3 4h26v20H3zM8 29h16M16 24v5M7 19l5-7 5 3 8-8",
        ["automation"] = "M3 8h7v7H3zM22 19h7v7h-7zM10 11h9v12h3M19 11h10M3 23h10"
    }; }
<section id="expertise" class="grid scroll-mt-32 gap-10 border-t border-line py-16 lg:py-24 md:grid-cols-[1fr_1.6fr]" aria-labelledby="expertise-title"><div data-reveal><p class="text-xs uppercase tracking-widest text-muted">@Localizer["ServiceLabel"]</p><h2 id="expertise-title" class="mt-5 font-editorial text-4xl">@Localizer["ServiceHeading"]</h2><p class="mt-5 max-w-md leading-7 text-muted">@Localizer["SeedNote"]</p><svg data-parallax="8" viewBox="0 0 160 90" class="mt-10 hidden h-24 w-40 text-signal lg:block" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1"><path d="M5 15H60V45H110V75H150M5 45H40V75H80M110 45V15H150"/><circle cx="5" cy="15" r="3"/><circle cx="150" cy="75" r="3"/><circle cx="150" cy="15" r="3"/><circle cx="80" cy="75" r="3"/></svg></div><div class="border-t border-line">
@if (Model.Services.Count == 0) { <p class="py-8 leading-7">@Localizer["Empty"]</p> }
@foreach (var service in Model.Services) {
<details class="group border-b transition-colors hover:bg-panel motion-reduce:transition-none border-line py-5"><summary class="flex min-h-11 cursor-pointer items-center gap-4"><svg viewBox="0 0 32 32" class="h-8 w-8 shrink-0 text-signal" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="@(iconPaths.GetValueOrDefault(service.Key, "M4 16h24"))"/></svg><span class="text-xs text-muted">@service.DisplayOrder.ToString("00")</span><span class="text-lg">@service.Title</span><span class="ms-auto text-accent transition-transform duration-200 motion-reduce:transition-none group-open:rotate-45" aria-hidden="true">+</span></summary><p class="mt-4 text-xs uppercase tracking-widest text-signal">@Localizer["DemoTag"]</p><p class="mt-3 max-w-lg leading-7 text-muted">@service.Summary</p></details>
}
</div></section>
