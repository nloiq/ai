@model HomeViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{var intro=Model.ServicesSection;}
@if(intro is null||intro.Visible){<section id="expertise" data-home-directory="services" class="scroll-mt-32 border-t border-line py-10 lg:py-14" aria-labelledby="expertise-title"><div class="grid items-center gap-6 lg:grid-cols-[1fr_1fr_auto]"><div><p class="text-xs uppercase tracking-widest text-signal">@L["DirectoryServices"]</p><h2 id="expertise-title" class="mt-3 break-words font-editorial text-3xl md:text-4xl">@(intro?.Title??L["DirectoryServices"].Value)</h2></div><p class="max-w-xl text-sm leading-7 text-muted line-clamp-3">@(intro?.Summary??L["DirectoryServicesIntro"].Value)</p><a href="/@Model.Culture/services" class="inline-flex min-h-12 items-center justify-center gap-5 rounded border border-accent px-5 text-sm text-accent">@L["DirectoryBrowseServices"]<span aria-hidden="true">@(Model.IsArabic?"←":"→")</span></a></div></section>}
