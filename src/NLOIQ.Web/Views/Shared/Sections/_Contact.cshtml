@model HomeViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> Localizer

@if(Model.Contact is not null){<partial name="_ContactSection" model="Model.Contact" />}else{
<section id="contact" class="scroll-mt-32 bg-evergreen px-5 pb-8 pt-16 text-ivory md:px-10 lg:pt-24" aria-labelledby="contact-title"><div class="mx-auto max-w-[1500px]"><p class="text-xs uppercase tracking-widest text-gold">@Localizer["ContactLabel"]</p><div class="mt-7 grid gap-10 border-b border-ivory/30 pb-14 lg:grid-cols-[1.4fr_1fr]"><h2 id="contact-title" class="font-editorial text-[clamp(3rem,6vw,6rem)] leading-[1.08] tracking-[-.035em]">@Localizer["ContactHeading1"]<br><em class="text-gold">@Localizer["ContactHeading2"]</em></h2><div class="self-end"><p class="max-w-lg text-lg leading-8 text-ivory/90">@Localizer["ContactIntro"]</p><p class="mt-5 max-w-lg text-sm leading-7 text-ivory/80">@Localizer["ContactPending"]</p></div></div><dl class="grid gap-8 border-b border-ivory/30 py-8 sm:grid-cols-2 lg:grid-cols-4">@foreach (var field in new[] { "Email", "Phone", "Office", "Hours" }) {<div><dt class="text-xs uppercase tracking-widest text-gold">@Localizer[field]</dt><dd class="mt-3 text-sm leading-7 text-ivory/80">@Localizer["AwaitingDetails"]</dd></div>}</dl></div></section>

}
