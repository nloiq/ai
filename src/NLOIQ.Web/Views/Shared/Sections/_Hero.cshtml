@model HomeViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> Localizer
@{var hero=Model.Hero;}
@if(hero is null || hero.Visible){
<section data-hero-revision="@hero?.RevisionId" class="grid scroll-mt-32 items-center gap-5 overflow-hidden border-b border-line py-10 lg:grid-cols-[1.12fr_1fr] lg:py-16" aria-labelledby="hero-title"><div class="min-w-0"><p class="mb-5 text-xs uppercase tracking-[.18em] text-signal">@Localizer["Phase"]</p><p class="mb-8 text-xs uppercase tracking-[.2em] text-muted">@Localizer["Eyebrow"]</p>
<h1 data-parallax="@(hero is null?6:Math.Round(hero.Parallax*12))" id="hero-title" class="font-editorial text-[clamp(2.75rem,6.1vw,6.5rem)] leading-[1.02] tracking-[-.055em] break-words">@if(hero is not null){@hero.Title}else{@Localizer["Heading1"]<br>@Localizer["Heading2"]<br><em class="text-accent">@Localizer["Heading3"]</em><br>@Localizer["Heading4"]}</h1>
@if(hero is null){<p class="mt-8 max-w-md text-base leading-7 text-muted">@Localizer["Intro"]</p>}else{if(!string.IsNullOrWhiteSpace(hero.Summary)){<p class="mt-8 max-w-md text-base leading-7 text-muted">@hero.Summary</p>}if(!string.IsNullOrWhiteSpace(hero.Body)){<div class="cms-body mt-5 max-w-xl leading-8">@Html.Raw(NLOIQ.Application.Content.ContentMarkup.Render(hero.Body))</div>}}
<a href="@(hero?.PrimaryTarget is string primary && !string.IsNullOrWhiteSpace(primary) && !string.IsNullOrWhiteSpace(hero.PrimaryLabel)?primary.Replace("{culture}",Model.Culture):$"/{Model.Culture}/projects")" class="mt-9 inline-flex min-h-12 items-center bg-accent px-6 py-3 text-sm text-on-accent">@(string.IsNullOrWhiteSpace(hero?.PrimaryLabel)?Localizer["ExploreWork"].Value:hero.PrimaryLabel)<span aria-hidden="true" class="ms-4">@(Model.IsArabic ? "↖" : "↗")</span></a>
<a href="@(hero?.SecondaryTarget is string secondary && !string.IsNullOrWhiteSpace(secondary) && !string.IsNullOrWhiteSpace(hero.SecondaryLabel)?secondary.Replace("{culture}",Model.Culture):"#about")" class="ms-5 mt-4 inline-flex min-h-12 items-center border-b border-ink text-sm">@(string.IsNullOrWhiteSpace(hero?.SecondaryLabel)?Localizer["Discover"].Value:hero.SecondaryLabel)</a></div>
@if(hero is not null && hero.Images.Count>0){<div class="grid min-w-0 gap-5">@foreach(var image in hero.Images){<figure><img src="@image.Url" srcset="@image.SrcSet" sizes="(min-width:1024px) 45vw,100vw" width="@image.Width" height="@image.Height" alt="@image.Alt" class="h-auto w-full object-contain">@if(!string.IsNullOrWhiteSpace(image.Caption)){<figcaption class="mt-3 text-sm text-muted">@image.Caption</figcaption>}</figure>}</div>}else{<partial name="_SystemStudy" />}
</section>}
