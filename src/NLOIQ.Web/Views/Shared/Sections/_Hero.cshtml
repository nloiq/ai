@model HomeViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{var hero=Model.Hero;}
@if(hero is null||hero.Visible){<section class="public-hero" data-hero-revision="@hero?.RevisionId" aria-labelledby="hero-title"><div><p class="public-kicker">@L["StudioEyebrow"]</p><h1 id="hero-title">@(hero?.Title??L["StudioHeroTitle"].Value)</h1><p class="public-hero-summary">@(string.IsNullOrWhiteSpace(hero?.Summary)?L["StudioHeroSummary"].Value:hero.Summary)</p>@if(!string.IsNullOrWhiteSpace(hero?.Body)){<div class="cms-body public-hero-body">@Html.Raw(NLOIQ.Application.Content.ContentMarkup.Render(hero.Body))</div>}<div class="public-actions"><a class="public-button" href="@((string.IsNullOrWhiteSpace(hero?.PrimaryTarget)||string.IsNullOrWhiteSpace(hero?.PrimaryLabel))?$"/{Model.Culture}/contact":hero.PrimaryTarget.Replace("{culture}",Model.Culture))">@(string.IsNullOrWhiteSpace(hero?.PrimaryLabel)?L["StudioDiscuss"].Value:hero.PrimaryLabel)<span aria-hidden="true">↗</span></a><a class="public-button public-button-secondary" href="@((string.IsNullOrWhiteSpace(hero?.SecondaryTarget)||string.IsNullOrWhiteSpace(hero?.SecondaryLabel))?$"/{Model.Culture}/projects":hero.SecondaryTarget.Replace("{culture}",Model.Culture))">@(string.IsNullOrWhiteSpace(hero?.SecondaryLabel)?L["ExploreWork"].Value:hero.SecondaryLabel)<span aria-hidden="true">→</span></a></div><p class="public-hero-meta">@L["StudioDisciplines"]</p></div><partial name="_ArchitectureVisual" /></section>}
@if(hero is {Visible:true} && hero.Images.Count>0){<details class="public-additional-media public-hero-media"><summary>@L["StudioSupportingMedia"] <span>@hero.Images.Count</span></summary><div class="public-additional-grid">@foreach(var image in hero.Images){<figure><a href="@image.Url"><img src="@image.Url" srcset="@image.SrcSet" sizes="(min-width:768px) 40vw,100vw" alt="@image.Alt" width="@image.Width" height="@image.Height" loading="lazy"></a><figcaption>@image.Caption</figcaption></figure>}</div></details>}
