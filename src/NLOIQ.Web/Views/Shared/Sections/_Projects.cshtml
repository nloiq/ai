@model HomeViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> Localizer

@{var projectsSection=Model.ProjectsSection;}
@if(projectsSection is null||projectsSection.Visible){
<section id="projects" data-projects-revision="@projectsSection?.RevisionId" class="scroll-mt-32 py-16 lg:py-24" aria-labelledby="projects-title"><div data-reveal class="grid gap-6 md:grid-cols-[1.3fr_1fr]"><div><p class="text-xs uppercase tracking-widest text-signal">@Localizer["ProjectsLabel"]</p><h2 id="projects-title" class="mt-5 font-editorial text-[clamp(2.5rem,4.5vw,4.5rem)] leading-tight">@(projectsSection?.Title??Localizer["ProjectsHeading"].Value)</h2></div><p class="max-w-lg self-end text-sm leading-7 text-muted">@(projectsSection?.Summary??Localizer["ProjectsNote"].Value)</p></div>
@if(projectsSection is not null && !string.IsNullOrWhiteSpace(projectsSection.Body)){<div class="cms-body mt-6 max-w-3xl leading-8">@Html.Raw(NLOIQ.Application.Content.ContentMarkup.Render(projectsSection.Body))</div>}
@if(Model.PublishedProjects.Count>0){<div class="mt-10"><h3 class="text-xl font-semibold">@Localizer["ProjectPortfolio"]</h3><div class="mt-6 grid items-start gap-6 md:grid-cols-2">@foreach(var project in Model.PublishedProjects){var path=$"/{Model.Culture}/projects/{project.Slug}";var cover=project.Images.FirstOrDefault();<article data-cms-project="@project.Key" class="min-w-0 overflow-hidden rounded-lg border border-line bg-panel">@if(cover is not null){<a href="@path" aria-label="@project.Title"><img src="@cover.Url" srcset="@cover.SrcSet" sizes="(min-width:768px) 45vw,100vw" width="@cover.Width" height="@cover.Height" alt="@cover.Alt" loading="lazy" class="aspect-[7/5] w-full object-cover"></a>}<div class="p-5"><h4 class="break-words text-2xl font-semibold"><a href="@path" class="underline underline-offset-4">@project.Title</a></h4>@if(project.Categories.Count>0){<p class="mt-3 text-xs text-signal">@string.Join(" / ",project.Categories)</p>}<p class="mt-3 break-words text-sm leading-7 text-muted">@project.Summary</p><a href="@path" class="mt-4 inline-flex min-h-11 items-center text-sm text-accent underline underline-offset-4">@Localizer["CmsDetails"]</a></div></article>}</div></div>}
@if(projectsSection is not null && projectsSection.Images.Count>0){<div data-section-gallery class="mt-10 grid items-start gap-6 md:grid-cols-2">@foreach(var image in projectsSection.Images){<figure class="min-w-0"><img src="@image.Url" srcset="@image.SrcSet" sizes="(min-width:768px) 45vw,100vw" width="@image.Width" height="@image.Height" alt="@image.Alt" loading="lazy" class="max-h-[520px] w-full rounded-lg border border-line bg-panel object-contain">@if(!string.IsNullOrWhiteSpace(image.Caption)){<figcaption class="mt-3 text-sm text-muted">@image.Caption</figcaption>}</figure>}</div>}
@if(Model.PublishedProjects.Count>0){<h3 class="mt-12 text-xl font-semibold">@Localizer["ProjectsConceptStudies"]</h3>}
<div class="mt-12 grid items-start gap-x-10 gap-y-12 md:grid-cols-12">
<article data-project="network" data-video-id="@Model.ProjectVideoIds.GetValueOrDefault("network")" class="min-w-0 md:col-span-7"><figure data-parallax="14"><a href="#study-title-1" data-project-open aria-haspopup="dialog" aria-controls="project-dialog" class="relative block overflow-hidden"><img data-parallax-layer src="~/images/network-study.svg" alt="@Localizer["Project1Alt"]" width="840" height="600" loading="lazy" class="aspect-[7/5] w-full scale-[1.04] object-cover transition-[scale] duration-300 hover:scale-[1.06] motion-reduce:transition-none motion-reduce:hover:scale-[1.04]">@if (!string.IsNullOrEmpty(Model.ProjectVideoIds.GetValueOrDefault("network"))) { <span aria-hidden="true" class="absolute inset-0 flex items-center justify-center"><span class="flex h-16 w-16 items-center justify-center border border-ivory bg-evergreen text-2xl text-ivory">▶</span></span> }</a><figcaption class="mt-4 flex flex-wrap justify-between gap-3 text-xs uppercase tracking-widest text-signal"><span>@Localizer["Illustration"]</span><span dir="ltr">01 / @Localizer["StudyLowCurrent"]</span></figcaption></figure><h3 id="study-title-1" data-project-title class="mt-4 font-editorial text-3xl">@Localizer["Project1"]</h3><p data-project-description class="mt-3 max-w-lg text-sm leading-7 text-muted">@Localizer["Project1Note"]</p><button type="button" hidden data-project-open aria-haspopup="dialog" aria-controls="project-dialog" aria-describedby="study-title-1" class="mt-5 inline-flex min-h-11 items-center gap-4 border-b border-accent text-sm text-accent transition-colors hover:text-signal motion-reduce:transition-none">@(string.IsNullOrEmpty(Model.ProjectVideoIds.GetValueOrDefault("network")) ? Localizer["OpenStudy"] : Localizer["WatchVideo"]) <span aria-hidden="true">@(Model.IsArabic ? "↖" : "↗")</span></button></article>
<article data-project="scada" data-video-id="@Model.ProjectVideoIds.GetValueOrDefault("scada")" class="min-w-0 md:col-span-5 md:mt-24"><figure data-parallax="14"><a href="#study-title-2" data-project-open aria-haspopup="dialog" aria-controls="project-dialog" class="relative block overflow-hidden"><img data-parallax-layer src="~/images/scada-study.svg" alt="@Localizer["Project2Alt"]" width="600" height="720" loading="lazy" class="aspect-[5/6] w-full scale-[1.04] object-cover transition-[scale] duration-300 hover:scale-[1.06] motion-reduce:transition-none motion-reduce:hover:scale-[1.04]">@if (!string.IsNullOrEmpty(Model.ProjectVideoIds.GetValueOrDefault("scada"))) { <span aria-hidden="true" class="absolute inset-0 flex items-center justify-center"><span class="flex h-16 w-16 items-center justify-center border border-ivory bg-evergreen text-2xl text-ivory">▶</span></span> }</a><figcaption class="mt-4 flex flex-wrap justify-between gap-3 text-xs uppercase tracking-widest text-signal"><span>@Localizer["Illustration"]</span><span dir="ltr">02 / @Localizer["StudyScada"]</span></figcaption></figure><h3 id="study-title-2" data-project-title class="mt-4 font-editorial text-3xl">@Localizer["Project2"]</h3><p data-project-description class="mt-3 text-sm leading-7 text-muted">@Localizer["Project2Note"]</p><button type="button" hidden data-project-open aria-haspopup="dialog" aria-controls="project-dialog" aria-describedby="study-title-2" class="mt-5 inline-flex min-h-11 items-center gap-4 border-b border-accent text-sm text-accent transition-colors hover:text-signal motion-reduce:transition-none">@(string.IsNullOrEmpty(Model.ProjectVideoIds.GetValueOrDefault("scada")) ? Localizer["OpenStudy"] : Localizer["WatchVideo"]) <span aria-hidden="true">@(Model.IsArabic ? "↖" : "↗")</span></button></article>
<article data-project="automation" data-video-id="@Model.ProjectVideoIds.GetValueOrDefault("automation")" class="min-w-0 md:col-span-9 md:col-start-2"><figure data-parallax="14"><a href="#study-title-3" data-project-open aria-haspopup="dialog" aria-controls="project-dialog" class="relative block overflow-hidden"><img data-parallax-layer src="~/images/automation-study.svg" alt="@Localizer["Project3Alt"]" width="1000" height="480" loading="lazy" class="aspect-[25/12] w-full scale-[1.04] object-cover transition-[scale] duration-300 hover:scale-[1.06] motion-reduce:transition-none motion-reduce:hover:scale-[1.04]">@if (!string.IsNullOrEmpty(Model.ProjectVideoIds.GetValueOrDefault("automation"))) { <span aria-hidden="true" class="absolute inset-0 flex items-center justify-center"><span class="flex h-16 w-16 items-center justify-center border border-ivory bg-evergreen text-2xl text-ivory">▶</span></span> }</a><figcaption class="mt-4 flex flex-wrap justify-between gap-3 text-xs uppercase tracking-widest text-signal"><span>@Localizer["Illustration"]</span><span dir="ltr">03 / @Localizer["StudyAutomation"]</span></figcaption></figure><div class="mt-4 grid gap-3 md:grid-cols-2"><h3 id="study-title-3" data-project-title class="font-editorial text-3xl">@Localizer["Project3"]</h3><p data-project-description class="text-sm leading-7 text-muted">@Localizer["Project3Note"]</p></div><button type="button" hidden data-project-open aria-haspopup="dialog" aria-controls="project-dialog" aria-describedby="study-title-3" class="mt-5 inline-flex min-h-11 items-center gap-4 border-b border-accent text-sm text-accent transition-colors hover:text-signal motion-reduce:transition-none">@(string.IsNullOrEmpty(Model.ProjectVideoIds.GetValueOrDefault("automation")) ? Localizer["OpenStudy"] : Localizer["WatchVideo"]) <span aria-hidden="true">@(Model.IsArabic ? "↖" : "↗")</span></button></article>
</div></section>

}
