@model HomeViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{var intro=Model.ProjectsSection;}
@if(intro is null||intro.Visible){<section id="projects" data-home-directory="projects" class="scroll-mt-32 border-t border-line py-10 lg:py-14" aria-labelledby="projects-title"><div class="grid items-center gap-6 lg:grid-cols-[1fr_1fr_auto]"><div><p class="text-xs uppercase tracking-widest text-signal">@L["DirectoryProjects"]</p><h2 id="projects-title" class="mt-3 break-words font-editorial text-3xl md:text-4xl">@(intro?.Title??L["DirectoryProjects"].Value)</h2></div><p class="max-w-xl text-sm leading-7 text-muted line-clamp-3">@(intro?.Summary??L["DirectoryProjectsIntro"].Value)</p><a href="/@Model.Culture/projects" class="inline-flex min-h-12 items-center justify-center gap-5 rounded border border-accent px-5 text-sm text-accent">@L["DirectoryBrowseProjects"]<span aria-hidden="true">@(Model.IsArabic?"←":"→")</span></a></div></section>}
