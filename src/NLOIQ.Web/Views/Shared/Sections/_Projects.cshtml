@model HomeViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> Localizer

<section id="projects" class="scroll-mt-32 py-16 lg:py-24" aria-labelledby="projects-title"><div class="grid gap-6 md:grid-cols-[1.3fr_1fr]"><div><p class="text-xs uppercase tracking-widest text-signal">@Localizer["ProjectsLabel"]</p><h2 id="projects-title" class="mt-5 font-editorial text-[clamp(2.5rem,4.5vw,4.5rem)] leading-tight">@Localizer["ProjectsHeading"]</h2></div><p class="max-w-lg self-end text-sm leading-7 text-muted">@Localizer["ProjectsNote"]</p></div>
<div class="mt-12 grid items-start gap-x-10 gap-y-12 md:grid-cols-12">
<article class="min-w-0 md:col-span-7"><figure><img src="~/images/network-study.svg" alt="@Localizer["Project1Alt"]" width="840" height="600" loading="lazy" class="aspect-[7/5] w-full object-cover"><figcaption class="mt-4 flex flex-wrap justify-between gap-3 text-xs uppercase tracking-widest text-signal"><span>@Localizer["Illustration"]</span><span dir="ltr">01 / LOW CURRENT</span></figcaption></figure><h3 class="mt-4 font-editorial text-3xl">@Localizer["Project1"]</h3><p class="mt-3 max-w-lg text-sm leading-7 text-muted">@Localizer["Project1Note"]</p></article>
<article class="min-w-0 md:col-span-5 md:mt-24"><figure><img src="~/images/scada-study.svg" alt="@Localizer["Project2Alt"]" width="600" height="720" loading="lazy" class="aspect-[5/6] w-full object-cover"><figcaption class="mt-4 flex flex-wrap justify-between gap-3 text-xs uppercase tracking-widest text-signal"><span>@Localizer["Illustration"]</span><span dir="ltr">02 / SCADA</span></figcaption></figure><h3 class="mt-4 font-editorial text-3xl">@Localizer["Project2"]</h3><p class="mt-3 text-sm leading-7 text-muted">@Localizer["Project2Note"]</p></article>
<article class="min-w-0 md:col-span-9 md:col-start-2"><figure><img src="~/images/automation-study.svg" alt="@Localizer["Project3Alt"]" width="1000" height="480" loading="lazy" class="aspect-[25/12] w-full object-cover"><figcaption class="mt-4 flex flex-wrap justify-between gap-3 text-xs uppercase tracking-widest text-signal"><span>@Localizer["Illustration"]</span><span dir="ltr">03 / SOFTWARE + AUTOMATION</span></figcaption></figure><div class="mt-4 grid gap-3 md:grid-cols-2"><h3 class="font-editorial text-3xl">@Localizer["Project3"]</h3><p class="text-sm leading-7 text-muted">@Localizer["Project3Note"]</p></div></article>
</div></section>
