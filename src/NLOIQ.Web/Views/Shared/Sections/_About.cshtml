@model HomeViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> Localizer

<section id="about" class="scroll-mt-32 bg-panel px-5 py-16 md:px-10 lg:py-24" aria-labelledby="about-title"><div class="mx-auto grid max-w-[1500px] gap-10 lg:grid-cols-[.65fr_1.35fr]"><div><p class="text-xs uppercase tracking-widest text-signal">@Localizer["AboutLabel"]</p><svg data-parallax="16" viewBox="0 0 360 310" class="mt-8 w-full max-w-sm text-ink" role="img" aria-label="@Localizer["AboutArt"]"><path d="M70 270C30 160 130 60 290 30C270 190 205 280 70 270Z" fill="none" stroke="currentColor" stroke-width="1" opacity=".2"/><g fill="none" stroke="currentColor" stroke-width="1.5"><path d="M40 280L260 60M95 225V140H35M150 170V80H90M150 170H250V240H315M205 115H310V60"/><circle cx="35" cy="140" r="5"/><circle cx="90" cy="80" r="5"/><circle cx="315" cy="240" r="5"/><circle cx="310" cy="60" r="5"/></g><path d="M40 280L260 60" class="stroke-accent" stroke-width="3"/></svg></div><div data-reveal><h2 id="about-title" class="max-w-3xl font-editorial text-[clamp(2.4rem,4.6vw,5rem)] leading-[1.12] tracking-[-.035em]">@Localizer["AboutHeading1"]<br><em class="text-accent">@Localizer["AboutHeading2"]</em></h2><p class="mt-8 max-w-2xl text-lg leading-8">@Localizer["AboutBody"]</p><p class="mt-5 max-w-2xl leading-7 text-muted">@Localizer["AboutSecondary"]</p><div class="mt-10 grid gap-6 border-t border-line pt-6 sm:grid-cols-2"><div><p class="text-xs uppercase tracking-widest text-signal">@Localizer["FromSignal"]</p><p class="mt-3 text-sm leading-7 text-muted">@Localizer["FromSignalNote"]</p></div><div><p class="text-xs uppercase tracking-widest text-signal">@Localizer["ToSystem"]</p><p class="mt-3 text-sm leading-7 text-muted">@Localizer["ToSystemNote"]</p></div></div></div></div></section>
