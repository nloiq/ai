@model HomeViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@if(Model.AboutSection is not null){if(Model.AboutSection.Visible){<section id="about" class="public-approach" aria-labelledby="about-title"><div><p class="public-kicker">@L["About"]</p><h2 id="about-title">@Model.AboutSection.Title</h2></div><div><p class="text-muted">@Model.AboutSection.Summary</p><div class="cms-body">@Html.Raw(NLOIQ.Application.Content.ContentMarkup.Render(Model.AboutSection.Body))</div></div></section>}}else{
<section id="about" class="public-approach" aria-labelledby="about-title"><div><p class="public-kicker">@L["StudioApproach"]</p><h2 id="about-title">@L["StudioApproachTitle"]</h2></div><div class="public-process">@foreach(var step in new[]{("01","StudioDefine","StudioDefineNote"),("02","StudioBuild","StudioBuildNote"),("03","StudioValidate","StudioValidateNote")}){<div><span class="public-index" dir="ltr">@step.Item1 /</span><h3>@L[step.Item2]</h3><p>@L[step.Item3]</p></div>}</div></section>

}
