@inject NLOIQ.Application.Content.IBrandReader BrandReader
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@inject IWebHostEnvironment Environment
@{var culture=Context.Request.RouteValues["culture"]?.ToString()=="ar"?"ar":"en";var brand=await BrandReader.ReadAsync(culture);var path=Context.Request.Path.Value??"/";var alternate="/"+(culture=="ar"?"en":"ar")+path[3..]+Context.Request.QueryString;string Absolute(string value)=>brand.BaseUrl is null?value:new Uri(new Uri(brand.BaseUrl),value).AbsoluteUri;}
<!doctype html><html lang="@culture" dir="@(culture=="ar"?"rtl":"ltr")" data-default-theme="@brand.DefaultTheme"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="@(Environment.IsDevelopment()?"noindex,nofollow":"index,follow")"><title>@ViewData["Title"] · @brand.SiteName</title><meta name="description" content="@ViewData["Description"]"><link rel="canonical" href="@Absolute(path+Context.Request.QueryString)"><link rel="alternate" hreflang="@culture" href="@Absolute(path+Context.Request.QueryString)"><link rel="alternate" hreflang="@(culture=="ar"?"en":"ar")" href="@Absolute(alternate)"><script src="~/js/theme-init.js" asp-append-version="true"></script><link rel="stylesheet" href="~/css/app.css" asp-append-version="true"><partial name="_BrandHead" model="brand" /><script src="~/js/admin.js" asp-append-version="true" defer></script></head><body class="min-h-screen bg-paper text-ink antialiased"><a href="#main" class="sr-only focus:not-sr-only focus:block focus:p-4">@L["Skip"]</a><header class="border-b border-line px-5 py-4 md:px-10"><div class="mx-auto flex max-w-[1500px] flex-wrap items-center justify-between gap-4"><a href="/@culture/" aria-label="@brand.SiteName"><partial name="_LogoMark" model="brand" /></a><nav aria-label="@L["Navigation"]" class="flex flex-wrap gap-5 text-sm"><a href="/@culture/" class="inline-flex min-h-11 items-center">@L["DirectoryHome"]</a><a href="/@culture/projects" class="inline-flex min-h-11 items-center">@L["DirectoryProjects"]</a><a href="/@culture/services" class="inline-flex min-h-11 items-center">@L["DirectoryServices"]</a><a href="/@culture/#contact" class="inline-flex min-h-11 items-center">@L["InquiryContactUs"]</a></nav><div class="flex flex-wrap items-center gap-4 text-sm"><a href="@alternate" lang="@(culture=="ar"?"en":"ar")" class="inline-flex min-h-11 items-center underline">@(culture=="ar"?"English":"العربية")</a><partial name="_ThemeSelector" model="brand" /></div></div></header><main id="main" tabindex="-1" class="mx-auto max-w-[1500px] px-5 py-12 md:px-10 lg:py-16">@RenderBody()</main><footer class="border-t border-line px-5 py-8 md:px-10"><div class="mx-auto flex max-w-[1500px] flex-wrap items-center justify-between gap-4 text-sm text-muted"><p dir="ltr">© @DateTime.UtcNow.Year @brand.SiteName</p><a href="/@culture/#contact" class="inline-flex min-h-11 items-center underline">@L["InquiryContactUs"]</a></div></footer></body></html>
