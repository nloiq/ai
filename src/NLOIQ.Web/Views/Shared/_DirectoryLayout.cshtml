@inject NLOIQ.Application.Content.IBrandReader BrandReader
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@inject IWebHostEnvironment Environment
@{var culture=Context.Request.RouteValues["culture"]?.ToString()=="ar"?"ar":"en";var brand=await BrandReader.ReadAsync(culture);var path=Context.Request.Path.Value??"/";var alternate="/"+(culture=="ar"?"en":"ar")+path[3..]+Context.Request.QueryString;string Absolute(string value)=>brand.BaseUrl is null?value:new Uri(new Uri(brand.BaseUrl),value).AbsoluteUri;}
<!doctype html><html lang="@culture" dir="@(culture=="ar"?"rtl":"ltr")" data-default-theme="@brand.DefaultTheme"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="@(Environment.IsDevelopment()?"noindex,nofollow":"index,follow")"><title>@ViewData["Title"] · @brand.SiteName</title><meta name="description" content="@ViewData["Description"]"><link rel="canonical" href="@Absolute(path+Context.Request.QueryString)"><link rel="alternate" hreflang="@culture" href="@Absolute(path+Context.Request.QueryString)"><link rel="alternate" hreflang="@(culture=="ar"?"en":"ar")" href="@Absolute(alternate)"><script src="~/js/theme-init.js" asp-append-version="true"></script><link rel="stylesheet" href="~/css/app.css" asp-append-version="true"><partial name="_BrandHead" model="brand" /><link rel="stylesheet" href="~/css/public.css" asp-append-version="true"><script src="~/js/app.js" asp-append-version="true" defer></script></head><body class="public-site min-h-screen bg-paper text-ink antialiased"><a href="#main" class="sr-only focus:not-sr-only focus:block focus:p-4">@L["Skip"]</a><partial name="_PublicHeader" model="new NLOIQ.Web.ViewModels.PublicShellModel(culture,brand,alternate)" /><main id="main" tabindex="-1" class="public-container public-directory-main">@RenderBody()</main><partial name="_PublicFooter" model="new NLOIQ.Web.ViewModels.PublicShellModel(culture,brand,alternate)" /></body></html>