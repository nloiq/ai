@model NLOIQ.Application.Content.PublicNode
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{Layout="_DirectoryLayout";var culture=Context.Request.RouteValues["culture"]?.ToString()=="ar"?"ar":"en";ViewData["Title"]=Model.Title;ViewData["Description"]=Model.Summary;}
<a href="/@culture/services" class="inline-flex min-h-11 items-center underline">@L["DirectoryBackServices"]</a><header class="my-8 max-w-4xl"><p class="text-xs uppercase tracking-widest text-signal">@L["ServiceCategory_"+Model.ServiceCategoryKey]</p><h1 class="mt-4 break-words font-editorial text-5xl md:text-7xl">@Model.Title</h1><p class="mt-6 text-lg leading-8 text-muted">@Model.Summary</p></header><div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_300px]"><div class="min-w-0">@foreach(var image in Model.Images){<figure class="mb-6"><a href="@image.Url"><img src="@image.Url" srcset="@image.SrcSet" sizes="(min-width:1024px) 65vw,100vw" alt="@image.Alt" width="@image.Width" height="@image.Height" class="max-h-[560px] w-full rounded-xl border border-line bg-panel object-contain"></a>@if(!string.IsNullOrWhiteSpace(image.Caption)){<figcaption class="mt-3 text-sm text-muted">@image.Caption</figcaption>}</figure>}<div class="cms-body max-w-3xl break-words leading-8">@Html.Raw(NLOIQ.Application.Content.ContentMarkup.Render(Model.Body))</div></div><aside class="rounded-xl border border-line bg-panel p-6"><h2 class="text-xl font-semibold">@L["InquiryContactUs"]</h2><p class="mt-3 text-sm leading-7 text-muted">@L["ProjectDiscussNote"]</p><a href="/@culture/#contact" class="mt-5 inline-flex min-h-11 items-center rounded bg-accent px-4 text-sm text-on-accent">@L["InquiryContactUs"]</a></aside></div>
