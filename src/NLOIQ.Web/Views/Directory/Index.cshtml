@model NLOIQ.Web.ViewModels.DirectoryModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{Layout="_DirectoryLayout";var c=Context.Request.RouteValues["culture"]?.ToString()=="ar"?"ar":"en";var type=Model.Projects?"projects":"services";ViewData["Title"]=L[Model.Projects?"DirectoryProjects":"DirectoryServices"];ViewData["Description"]=L[Model.Projects?"DirectoryProjectsIntro":"DirectoryServicesIntro"];var groups=string.IsNullOrEmpty(Model.Selected)?Model.Categories:Model.Categories.Where(x=>x.Key==Model.Selected).ToList();}
<header class="public-directory-heading"><div><p class="public-kicker">@L["StudioEyebrow"]</p><h1>@ViewData["Title"]</h1><p>@(Model.Intro?.Summary??ViewData["Description"])</p>@if(!string.IsNullOrWhiteSpace(Model.Intro?.Body)){<div class="cms-body">@Html.Raw(NLOIQ.Application.Content.ContentMarkup.Render(Model.Intro.Body))</div>}</div><span class="public-heading-index" aria-hidden="true" dir="ltr">@(Model.Projects?"01":"02") /</span></header>
<nav aria-label="@L["DirectoryCategory"]" class="public-filters"><a href="/@c/@type" aria-current="@(string.IsNullOrEmpty(Model.Selected)?"page":null)" class="directory-filter">@L["DirectoryAll"] <span>@Model.Items.Count</span></a>@foreach(var category in Model.Categories){<a href="/@c/@type?category=@Uri.EscapeDataString(category.Key)" aria-current="@(Model.Selected==category.Key?"page":null)" class="directory-filter">@category.Label <span>@Model.Items.Count(x=>Model.Matches(x,category.Key))</span></a>}</nav>
@if(Model.Items.Count==0){<p class="public-empty">@L["DirectoryEmpty"]</p>}
@foreach(var category in groups){var items=Model.Items.Where(x=>Model.Matches(x,category.Key)).ToList();<section data-directory-group="@category.Key" class="public-directory-group"><div class="public-group-heading"><h2>@category.Label</h2><span class="public-index">@items.Count.ToString("00")</span></div><div class="public-card-grid @(items.Count==1?"public-card-single":"")">@foreach(var item in items){var url=$"/{c}/{type}/{(Model.Projects?item.Slug:item.Key)}";var image=item.Images.FirstOrDefault();<article data-directory-item="@item.Key" class="public-work-card"><a class="public-card-media" href="@url" aria-label="@item.Title">@if(image is not null){<img src="@image.Url" srcset="@image.SrcSet" sizes="(min-width:1024px) 45vw,100vw" alt="@image.Alt" width="@image.Width" height="@image.Height" loading="lazy">}else{<svg viewBox="0 0 400 220" aria-hidden="true" class="public-card-schematic"><g fill="none" stroke="currentColor" stroke-width="1.5"><rect x="35" y="45" width="95" height="55" rx="7"/><rect x="270" y="45" width="95" height="55" rx="7"/><path d="M82 100v35h118m118-35v35H200v30M175 165h50v30h-50z"/><path d="M60 72h45m190 0h45"/><circle cx="200" cy="135" r="4"/></g></svg>}<span class="public-card-arrow" aria-hidden="true">↗</span></a><div class="public-card-copy"><p class="public-kicker">@category.Label</p><h3><a href="@url">@item.Title</a></h3><p>@item.Summary</p><a class="public-text-link" href="@url">@L[Model.Projects?"CmsDetails":"DirectoryReadService"] <span aria-hidden="true">→</span></a></div></article>}</div></section>}
@if(Model.Projects&&Model.Intro?.Images.Count>0&&string.IsNullOrEmpty(Model.Selected)){<details class="public-additional-media"><summary>@L["ProjectGallery"] <span>@Model.Intro.Images.Count</span></summary><div class="public-additional-grid">@foreach(var image in Model.Intro.Images){<figure><a href="@image.Url"><img src="@image.Url" alt="@image.Alt" width="@image.Width" height="@image.Height" loading="lazy"></a>@if(!string.IsNullOrWhiteSpace(image.Caption)){<figcaption>@image.Caption</figcaption>}</figure>}</div></details>}
