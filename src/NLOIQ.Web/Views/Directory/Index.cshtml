@model NLOIQ.Web.ViewModels.DirectoryModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{Layout="_DirectoryLayout";var culture=Context.Request.RouteValues["culture"]?.ToString()=="ar"?"ar":"en";var type=Model.Projects?"projects":"services";ViewData["Title"]=L[Model.Projects?"DirectoryProjects":"DirectoryServices"];ViewData["Description"]=L[Model.Projects?"DirectoryProjectsIntro":"DirectoryServicesIntro"];var groups=string.IsNullOrEmpty(Model.Selected)?Model.Categories:Model.Categories.Where(x=>x.Key==Model.Selected).ToList();}
<header class="max-w-4xl"><p class="text-xs uppercase tracking-widest text-signal">@L["DirectoryCategory"]</p><h1 class="mt-4 font-editorial text-5xl md:text-7xl">@ViewData["Title"]</h1><p class="mt-5 max-w-3xl text-lg leading-8 text-muted">@(Model.Intro?.Summary??ViewData["Description"])</p>@if(!string.IsNullOrWhiteSpace(Model.Intro?.Body)){<div class="cms-body mt-4 leading-8">@Html.Raw(NLOIQ.Application.Content.ContentMarkup.Render(Model.Intro.Body))</div>}</header>
<nav aria-label="@L["DirectoryCategory"]" class="my-9 flex flex-wrap gap-3"><a href="/@culture/@type" aria-current="@(string.IsNullOrEmpty(Model.Selected)?"page":null)" class="directory-filter">@L["DirectoryAll"] <span class="ms-2 text-xs">@Model.Items.Count</span></a>@foreach(var category in Model.Categories){<a href="/@culture/@type?category=@Uri.EscapeDataString(category.Key)" aria-current="@(Model.Selected==category.Key?"page":null)" class="directory-filter">@category.Label <span class="ms-2 text-xs">@Model.Items.Count(x=>Model.Matches(x,category.Key))</span></a>}</nav>
@if(Model.Items.Count==0){<p class="border border-line bg-panel p-8">@L["DirectoryEmpty"]</p>}
@foreach(var category in groups){var items=Model.Items.Where(x=>Model.Matches(x,category.Key)).ToList();<section data-directory-group="@category.Key" class="mb-12"><h2 class="mb-6 border-b border-line pb-4 text-2xl font-semibold">@category.Label <span class="ms-2 text-sm text-muted">@items.Count</span></h2><div class="grid items-start gap-6 md:grid-cols-2 xl:grid-cols-3">@foreach(var item in items){var url=$"/{culture}/{type}/{(Model.Projects?item.Slug:item.Key)}";var image=item.Images.FirstOrDefault();<article data-directory-item="@item.Key" class="min-w-0 overflow-hidden rounded-xl border border-line bg-panel">@if(image is not null){<a href="@url" aria-label="@item.Title"><img src="@image.Url" srcset="@image.SrcSet" sizes="(min-width:1280px) 30vw,(min-width:768px) 45vw,100vw" alt="@image.Alt" width="@image.Width" height="@image.Height" loading="lazy" class="aspect-[7/5] w-full object-cover"></a>}<div class="p-6"><h3 class="break-words text-2xl font-semibold"><a href="@url" class="underline underline-offset-4">@item.Title</a></h3><p class="mt-4 break-words text-sm leading-7 text-muted line-clamp-3">@item.Summary</p><a href="@url" class="mt-5 inline-flex min-h-11 items-center text-sm text-accent underline">@L[Model.Projects?"CmsDetails":"DirectoryReadService"]</a></div></article>}</div></section>}
@if(Model.Projects&&string.IsNullOrEmpty(Model.Selected)&&Model.Intro is not null&&Model.Intro.Images.Count>0){<section class="mt-12 border-t border-line pt-8"><h2 class="mb-5 text-2xl font-semibold">@L["ProjectGallery"]</h2><div class="grid items-start gap-6 md:grid-cols-2">@foreach(var image in Model.Intro.Images){<figure><a href="@image.Url"><img src="@image.Url" srcset="@image.SrcSet" sizes="(min-width:768px) 45vw,100vw" width="@image.Width" height="@image.Height" alt="@image.Alt" loading="lazy" class="max-h-[480px] w-full rounded-lg border border-line bg-panel object-contain"></a>@if(!string.IsNullOrWhiteSpace(image.Caption)){<figcaption class="mt-3 text-sm text-muted">@image.Caption</figcaption>}</figure>}</div></section>}
