@model AdminDashboardModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{ Layout = "_AdminLayout"; ViewData["Title"] = L["AdminDashboard"]; var cards = new List<(string Label, int Count)> { ("AdminContent", Model.Content), ("AdminDrafts", Model.Drafts), ("AdminPublished", Model.Published), ("AdminMedia", Model.Media) }; if (User.IsInRole("SuperAdmin")) cards.Add(("AdminUsers",Model.Users)); }
<p class="text-xs uppercase tracking-widest text-signal">@L["AdminPhase"]</p><h1 class="mt-4 max-w-3xl text-3xl font-semibold md:text-5xl">@L["AdminIntro"]</h1><p class="mt-5 text-muted">@L["AdminHint"]</p>
<div class="mt-10 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">@foreach(var card in cards) { <article class="border border-line bg-panel p-6"><h2 class="text-sm text-muted">@L[card.Label]</h2><p class="mt-5 text-5xl font-semibold tabular-nums">@card.Count</p></article> }</div>
<div class="mt-8 grid gap-6 xl:grid-cols-2"><section class="border border-line p-6"><h2 class="text-xl">@L["AdminPermissions"]</h2><ul class="mt-4 space-y-3 text-sm text-muted"><li>@L["AdminRead"]</li>@if(User.IsInRole("SuperAdmin") || User.IsInRole("Editor")) { <li>@L["AdminEdit"]</li> }@if(User.IsInRole("SuperAdmin")) { <li>@L["AdminManage"]</li> }</ul></section><section class="border-s-2 border-accent bg-panel p-6"><h2 class="text-xl">@L["AdminEditor"]</h2><p class="mt-4 text-sm leading-7 text-muted">@L["AdminPending"]</p></section></div>
