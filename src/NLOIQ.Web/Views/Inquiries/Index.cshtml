@model IReadOnlyList<NLOIQ.Domain.Entities.ContactInquiry>
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{Layout="_AdminLayout";ViewData["Title"]=L["InquiryInbox"];var culture=Context.Request.RouteValues["culture"]?.ToString()=="ar"?"ar":"en";var page=(int)ViewData["Page"]!;}
<h1 class="text-3xl">@L["InquiryInbox"]</h1>@if(Model.Count==0){<p class="mt-6">@L["InquiryEmpty"]</p>}<div class="mt-7 grid gap-4">@foreach(var item in Model){<article class="min-w-0 border border-line bg-panel p-5"><div class="flex flex-wrap justify-between gap-3"><h2 class="break-words text-xl">@item.Name</h2><span class="text-sm text-signal">@L[item.IsRead?"InquiryRead":"InquiryUnread"]</span></div><p class="mt-2 break-all text-sm">@item.Email</p><p class="mt-3 text-xs text-muted">@L["InquiryReceived"]: @item.CreatedUtc.AddHours(3).ToString("yyyy-MM-dd HH:mm")</p><a href="/@culture/admin/inquiries/@item.Id" class="mt-3 inline-flex min-h-11 items-center underline">@L["InquiryOpen"]</a></article>}</div><nav class="mt-6 flex gap-5">@if(page>1){<a href="?page=@(page-1)" class="inline-flex min-h-11 items-center underline">@L["InquiryPrevious"]</a>}@if(ViewData["HasNext"] is true){<a href="?page=@(page+1)" class="inline-flex min-h-11 items-center underline">@L["InquiryNext"]</a>}</nav>
