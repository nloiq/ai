@model NLOIQ.Domain.Entities.ContactInquiry
@inject Microsoft.Extensions.Localization.IStringLocalizer<NLOIQ.Web.SharedResource> L
@{Layout="_AdminLayout";ViewData["Title"]=L["InquiryInbox"];var culture=Context.Request.RouteValues["culture"]?.ToString()=="ar"?"ar":"en";}
<a href="/@culture/admin/inquiries" class="inline-flex min-h-11 items-center underline">@L["InquiryInbox"]</a><h1 class="mt-5 break-words text-3xl">@Model.Name</h1><p class="mt-3 text-sm text-muted">@L["InquiryReceived"]: @Model.CreatedUtc.AddHours(3).ToString("yyyy-MM-dd HH:mm")</p><dl class="mt-7 grid gap-5 border border-line bg-panel p-6 sm:grid-cols-2">@foreach(var field in new[]{("InquiryEmail",Model.Email),("InquiryPhone",Model.Phone),("InquiryCompany",Model.Company),("InquiryService",Model.Service)}){<div class="min-w-0"><dt class="text-sm text-muted">@L[field.Item1]</dt><dd class="mt-2 break-words" dir="auto">@field.Item2</dd></div>}</dl><h2 class="mt-7 text-xl">@L["InquiryMessage"]</h2><p class="mt-4 whitespace-pre-wrap break-words border border-line p-6 leading-8" dir="auto">@Model.Message</p>@if(!Model.IsRead){<form method="post" action="/@culture/admin/inquiries/@Model.Id/read" asp-antiforgery="true" class="mt-6"><button type="submit" class="cms-small">@L["InquiryMarkRead"]</button></form>}
